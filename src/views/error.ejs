  <div class="d-flex gap-2">
    <a href="/" class="btn btn-cta-nav">Go to homepage</a>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a>
  </div>

</main>

<%- include('./partials/footer') %>

</body>
</html>