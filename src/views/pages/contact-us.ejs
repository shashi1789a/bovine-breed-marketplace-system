          Team is online · Average reply: 47 minutes
        </div>

        <form class="contact-form needs-validation" id="contactForm" action="/process-demo" method="POST" novalidate>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="fname" class="form-label">First Name <span class="req">*</span></label>
              <input type="text" class="form-control" id="fname" name="first_name" placeholder="Your First Name" required autocomplete="given-name">
              <div class="invalid-feedback">Please enter your first name.</div>
            </div>
            <div class="col-md-6">
              <label for="lname" class="form-label">Last Name <span class="req">*</span></label>
              <input type="text" class="form-control" id="lname" name="last_name" placeholder="Your Last Name" required autocomplete="family-name">
              <div class="invalid-feedback">Please enter your last name.</div>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Email Address <span class="req">*</span></label>
              <input type="email" class="form-control" id="email" name="email" placeholder="xxxxxxxx@example.com" required autocomplete="email">
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="99XXXXXXXX" autocomplete="tel" maxlength="10" pattern="[6-9][0-9]{9}" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)">
            </div>
            <div class="col-12">
              <label for="business" class="form-label">Type of Bovin Business</label>
              <select class="form-select" id="business" name="business_type">
                <option value="">Select your business type</option>
                <option value="Bovin Farmer">Bovin Farmer</option>
                  <option value="Milk Collection Centre">Milk Collection Center Owner</option>
                  <option value="Milk Delivery">Milk Delivery Business</option>
                  <option value="Delivery Boy">Delivery Partner</option>
                  <option value="Cattle Trader">Cattle Trader / Dealer</option>
                  <option value="Gaushala Manager">Gaushala Manager</option>
                  <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-12">
              <label for="subject" class="form-label">Subject <span class="req">*</span></label>
              <select class="form-select" id="subject" name="subject" required>
                <option value="">Select a subject</option>
                <option value="Start Free Trial">Start Free Trial</option>
                <option value="Book a Demo">Book a Demo</option>
                <option value="Pricing Inquiry">Pricing Inquiry</option>
                <option value="Technical Support">Technical Support</option>
                <option value="Partnership / Reseller">Partnership / Reseller</option>
                <option value="other">Other</option>
              </select>
              <div class="invalid-feedback">Please select a subject.</div>
            </div>
            <div class="col-12">
              <label for="message" class="form-label">Message <span class="req">*</span></label>
              <textarea class="form-control" id="message" name="message" rows="5" placeholder="Tell us about your bovin business and what you're looking for..." required></textarea>
              <div class="invalid-feedback">Please write your message.</div>
            </div>
            <div class="col-12">
              <button type="submit" name="submit" value="submit" class="btn-primary-brand btn-submit d-flex w-100 justify-content-center">
                Send Message <i class="fas fa-paper-plane ms-2"></i>
              </button>
            </div>
          </div>
			<!-- Hidden fields for backend processing -->
            <input type="hidden" name="name" id="hidden-name">
            <input type="hidden" name="mobile" id="hidden-mobile">
            <input type="hidden" name="email_id" id="hidden-email-id">
            <input type="hidden" name="service_name" id="hidden-service-name">
            <input type="hidden" name="contant_link" value="https://bovinetra.in/contact-us">
            <input type="hidden" name="utm_source" value="">
            <input type="hidden" name="utm_medium" value="">
            <input type="hidden" name="utm_campaign" value="">
        </form>
		  
		  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
          document.getElementById('contactForm').addEventListener('submit', function() {
            document.getElementById('hidden-name').value = document.getElementById('fname').value + ' ' + document.getElementById('lname').value;
            document.getElementById('hidden-mobile').value = document.getElementById('phone').value;
            document.getElementById('hidden-email-id').value = document.getElementById('email').value;
            document.getElementById('hidden-service-name').value = document.getElementById('business').value;  
          });
          </script>
      </div>

