<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" rel="stylesheet">
  <link href="/assets/css/tools.css" rel="stylesheet">
  <style>
    #map { height: 68vh; min-height: 380px; border-radius: 20px; border: 1px solid var(--border-light); }
    .map-tools { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
    .map-tools .field { width: auto; min-width: 140px; }
    .pop { min-width: 190px; }
    .pop img { width: 100%; height: 110px; object-fit: cover; border-radius: 10px; margin-bottom: 6px; }
    .pop strong { display: block; }
    .pop a { display: inline-block; margin-top: 6px; font-weight: 700; color: var(--primary); }
  </style>
</head>
<body>
<%- include('../partials/header') %>

<main class="page">
  <div class="wrap">
    <div class="page-head">
      <div>
        <h2><%= t('Cattle on the map') %></h2>
        <p class="muted" id="mapCount"><%= t('Loading...') %></p>
      </div>
      <a class="btn-soft" href="/products?type=cattle"><i class="fas fa-list"></i> <%= t('List view') %></a>
    </div>

    <form class="map-tools" id="mapFilters">
      <select class="field" name="state" aria-label="<%= t('State') %>">
        <option value=""><%= t('All states') %></option>
        <% states.forEach(function (st) { %><option value="<%= st %>"><%= st %></option><% }) %>
      </select>
      <input class="field" type="number" name="maxPrice" min="0" placeholder="<%= t('Max price') %> (₹)" aria-label="<%= t('Max price') %>">
      <input class="field" type="number" name="minMilk" min="0" step="0.5" placeholder="<%= t('Min milk per day') %>" aria-label="<%= t('Min milk per day') %>">
      <select class="field" name="radius" aria-label="<%= t('Distance') %>">
        <% nearRadii.forEach(function (km) { %><option value="<%= km %>" <%= km === 50 ? 'selected' : '' %>><%= km %> km</option><% }) %>
      </select>
      <button type="button" class="btn-main" id="locate"><i class="fas fa-location-crosshairs"></i> <%= t('Near me') %></button>
      <button type="button" class="btn-soft" id="reset"><%= t('Reset') %></button>
    </form>

    <div id="map" role="application" aria-label="<%= t('Cattle on the map') %>"></div>
  </div>
</main>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
  (function () {
    var text = <%- JSON.stringify({
      found: t('{n} cattle on the map'),
      none: t('No cattle with a location found. Try wider filters.'),
      more: t('Showing the first 500. Narrow the filters to see others.'),
      price: t('Price on request'),
      view: t('View details'),
      failed: t('Could not load the map data. Please try again.'),
      denied: t('Could not get your location. Please allow location access.')
    }) %>;

    var map = L.map('map').setView([22.9, 79.6], 5);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    var layer = L.layerGroup().addTo(map);
    var form = document.getElementById('mapFilters');
    var count = document.getElementById('mapCount');
    var me = null;
    var meMarker = null;
    var timer = null;

    function popup(point) {
      var box = document.createElement('div');
      box.className = 'pop';

      if (/^https:\/\//.test(point.image)) {
        var img = document.createElement('img');
        img.src = point.image;
        img.alt = '';
        box.appendChild(img);
      }

      var title = document.createElement('strong');
      title.textContent = point.title || point.breed;
      box.appendChild(title);

      var line = document.createElement('span');
      line.textContent = (typeof point.price === 'number' ? '₹ ' + point.price.toLocaleString('en-IN') : text.price) +
        (point.place ? ' · ' + point.place : '');
      box.appendChild(line);

      var link = document.createElement('a');
      link.href = '/cattle/' + encodeURIComponent(point.id);
      link.textContent = text.view;
      box.appendChild(document.createElement('br'));
      box.appendChild(link);

      return box;
    }

    function query() {
      var params = new URLSearchParams();

      new FormData(form).forEach(function (value, key) {
        value = String(value).trim();
        if (value && key !== 'radius') params.set(key, value);
      });

      if (me) {
        params.set('lat', me.lat.toFixed(3));
        params.set('lng', me.lng.toFixed(3));
        params.set('radius', form.elements.radius.value);
      }

      return params.toString();
    }

    function load() {
      fetch('/cattle/map/data?' + query(), { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.ok ? res.json() : Promise.reject(); })
        .then(function (json) {
          var data = json.data;
          layer.clearLayers();

          data.points.forEach(function (point) {
            L.marker([point.lat, point.lng]).bindPopup(popup(point)).addTo(layer);
          });

          count.textContent = data.points.length
            ? text.found.replace('{n}', data.points.length) + (data.truncated ? '. ' + text.more : '')
            : text.none;

          if (data.points.length) {
            var bounds = L.latLngBounds(data.points.map(function (p) { return [p.lat, p.lng]; }));
            map.fitBounds(bounds.pad(0.2), { maxZoom: me ? 11 : 9 });
          }
        })
        .catch(function () { count.textContent = text.failed; });
    }

    form.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(load, 350);
    });

    document.getElementById('locate').addEventListener('click', function () {
      if (!navigator.geolocation) return;

      navigator.geolocation.getCurrentPosition(function (position) {
        me = { lat: position.coords.latitude, lng: position.coords.longitude };
        if (meMarker) map.removeLayer(meMarker);
        meMarker = L.circleMarker([me.lat, me.lng], { radius: 8, color: '#0F62AC', fillColor: '#0F62AC', fillOpacity: 0.9 }).addTo(map);
        load();
      }, function () { count.textContent = text.denied; }, { timeout: 10000, maximumAge: 600000 });
    });

    document.getElementById('reset').addEventListener('click', function () {
      form.reset();
      me = null;
      if (meMarker) map.removeLayer(meMarker);
      load();
    });

    load();
  })();
</script>
</body>
</html>
