<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || product.name %> | BoviNetra</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0284C7;
      --primary-dark: #0C4A6E;
      --accent: #0EA5E9;
      --cta: #F59E0B;
      --light: #E0F2FE;
      --text-main: #111827;
      --text-muted: #6B7280;
      --border-light: rgba(2, 132, 199, 0.12);
      --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
      --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
      --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
      --radius-card: 20px;
      --radius-md: 16px;
      --radius-sm: 10px;
      --radius-pill: 50px;
      --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { font-family: 'Inter', sans-serif; background: #F4F9FE; color: var(--text-main); overflow-x: hidden; }

    .pv-page { min-height: 100vh; padding-top: 120px; padding-bottom: 60px; }

    .pv-back { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--primary); border: 1.5px solid var(--border-light); border-radius: var(--radius-pill); padding: 0.55rem 1.2rem; font-weight: 600; font-size: 0.85rem; text-decoration: none; transition: var(--transition); margin-bottom: 1.5rem; }
    .pv-back:hover { background: var(--light); border-color: var(--primary); color: var(--primary-dark); transform: translateX(-3px); }

    .pv-alert { border-radius: var(--radius-md); padding: 0.95rem 1.2rem; font-weight: 500; font-size: 0.9rem; margin-bottom: 1.2rem; display: flex; align-items: flex-start; gap: 10px; }
    .pv-alert a { color: inherit; font-weight: 700; }
    .pv-alert-danger { background: #FEE2E2; color: #991B1B; border-left: 4px solid #EF4444; }
    .pv-alert-warning { background: #FEF3C7; color: #92400E; border-left: 4px solid var(--cta); }
    .pv-alert-secondary { background: #E0F2FE; color: var(--primary-dark); border-left: 4px solid var(--primary); }
    .pv-alert-success { background: #DCFCE7; color: #166534; border-left: 4px solid #16A34A; }

    .pv-image-card { background: #fff; border: 1px solid var(--border-light); border-radius: var(--radius-card); padding: 1rem; box-shadow: var(--shadow-sm); }
    .pv-main-image { display: block; width: 100%; max-height: 460px; object-fit: cover; border-radius: var(--radius-md); border: 1.5px solid var(--border-light); background: #EAF3FB; transition: opacity 0.15s ease; }
    .pv-image-placeholder { height: 340px; border-radius: var(--radius-md); background: #EAF3FB; border: 1.5px dashed rgba(2, 132, 199, 0.25); display: flex; align-items: center; justify-content: center; color: #93C5FD; font-size: 3rem; }

    .pv-gallery { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 0.85rem; }
    .pv-thumb { width: 72px; height: 72px; padding: 0; overflow: hidden; border-radius: var(--radius-sm); border: 2px solid var(--border-light); background: #F8FDFF; cursor: pointer; transition: var(--transition); }
    .pv-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .pv-thumb:hover { border-color: var(--primary); transform: translateY(-3px); }
    .pv-thumb:focus-visible { outline: 3px solid rgba(2, 132, 199, 0.4); }
    .pv-thumb.active { border-color: var(--cta); box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25); }

    .pv-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 0.85rem; }
    .pv-badge { font-weight: 700; font-size: 0.68rem; padding: 5px 12px; border-radius: var(--radius-pill); letter-spacing: 0.04em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 5px; }
    .pv-badge-category { background: var(--gradient-primary); color: #fff; }
    .pv-badge-sub { background: #F0F9FF; color: var(--primary-dark); border: 1px solid rgba(2, 132, 199, 0.18); }

    .pv-title { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 1.7rem; letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 0.5rem; word-break: break-word; }
    .pv-brand { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 6px; }
    .pv-brand i { color: var(--primary); }
    .pv-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; font-size: 0.88rem; }
    .pv-rating .stars { color: var(--cta); font-weight: 700; }

    .pv-price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 0.5rem; }
    .pv-price { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 2rem; color: var(--primary); letter-spacing: -0.03em; line-height: 1; }
    .pv-mrp { color: #9CA3AF; text-decoration: line-through; font-size: 1rem; font-weight: 500; }
    .pv-discount { background: var(--gradient-cta); color: #fff; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.72rem; padding: 4px 12px; border-radius: var(--radius-pill); }
    .pv-tax-note { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1rem; }

    .pv-stock { font-size: 0.86rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: var(--radius-pill); margin-bottom: 1rem; }
    .pv-stock-in { color: #0369A1; background: rgba(2, 132, 199, 0.1); }
    .pv-stock-low { color: #B45309; background: rgba(245, 158, 11, 0.14); }
    .pv-stock-out { color: #DC2626; background: rgba(220, 38, 38, 0.1); }

    .pv-short-desc { color: #4B5563; font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.5rem; }

    .pv-cart-form { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .pv-qty-input { max-width: 100px; background: #F8FDFF; border: 1.5px solid #E2EDF7; border-radius: 14px; padding: 11px 14px; font-size: 0.9rem; font-weight: 600; text-align: center; transition: var(--transition); }
    .pv-qty-input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.14); background: #fff; }
    .pv-add-btn { background: var(--gradient-cta); color: #fff; border: none; border-radius: var(--radius-pill); padding: 0.75rem 1.8rem; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.92rem; box-shadow: 0 6px 20px rgba(245, 158, 11, 0.38); transition: var(--transition); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .pv-add-btn:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(245, 158, 11, 0.5); }
    .pv-unavailable { background: #9CA3AF; color: #fff; border: none; border-radius: var(--radius-pill); padding: 0.75rem 1.8rem; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.92rem; cursor: not-allowed; margin-bottom: 1.25rem; display: inline-flex; align-items: center; gap: 8px; }

    .pv-owner-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .pv-owner-actions form { margin: 0; }
    .pv-btn-outline { background: #fff; border: 1.5px solid var(--border-light); border-radius: var(--radius-pill); padding: 0.6rem 1.4rem; font-weight: 600; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 7px; text-decoration: none; transition: var(--transition); cursor: pointer; }
    .pv-btn-outline-primary { color: var(--primary); border-color: rgba(2, 132, 199, 0.3); }
    .pv-btn-outline-primary:hover { background: var(--light); border-color: var(--primary); color: var(--primary-dark); transform: translateY(-2px); }
    .pv-btn-outline-danger { color: #DC2626; border-color: rgba(220, 38, 38, 0.3); }
    .pv-btn-outline-danger:hover { background: #FEE2E2; border-color: #DC2626; color: #991B1B; transform: translateY(-2px); }

    .pv-specs { width: 100%; border-collapse: separate; border-spacing: 0; border-radius: var(--radius-md); overflow: hidden; border: 1.5px solid var(--border-light); margin-bottom: 1.5rem; background: #fff; }
    .pv-specs th { background: #F0F9FF; color: var(--primary-dark); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 11px 16px; width: 42%; border-bottom: 1px solid rgba(2, 132, 199, 0.1); vertical-align: middle; }
    .pv-specs td { padding: 11px 16px; font-size: 0.9rem; border-bottom: 1px solid rgba(2, 132, 199, 0.08); vertical-align: middle; }
    .pv-specs tr:last-child th, .pv-specs tr:last-child td { border-bottom: none; }

    .pv-seller-card { background: linear-gradient(135deg, #F0F9FF, #E0F2FE); border: 1.5px solid rgba(2, 132, 199, 0.15); border-radius: var(--radius-md); padding: 1.3rem 1.4rem; }
    .pv-seller-title { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.88rem; color: var(--primary-dark); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 8px; }
    .pv-seller-title i { width: 28px; height: 28px; border-radius: 8px; background: #fff; display: inline-flex; align-items: center; justify-content: center; color: var(--primary); font-size: 0.78rem; border: 1px solid rgba(2, 132, 199, 0.18); }
    .pv-seller-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 4px; }
    .pv-seller-role { font-size: 0.78rem; color: var(--primary); text-transform: capitalize; font-weight: 600; margin-bottom: 0.6rem; }
    .pv-seller-info { font-size: 0.84rem; color: var(--text-muted); display: flex; align-items: center; gap: 7px; margin-bottom: 4px; }
    .pv-seller-info i { color: var(--primary); font-size: 0.78rem; width: 14px; }

    .pv-section-heading { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.2rem; margin: 0 0 1rem; display: flex; align-items: center; gap: 10px; }
    .pv-section-heading i { color: var(--primary); font-size: 1rem; width: 34px; height: 34px; border-radius: 10px; background: var(--light); display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(2, 132, 199, 0.15); }
    .pv-description { font-size: 0.95rem; color: #4B5563; line-height: 1.8; white-space: pre-line; word-break: break-word; background: #fff; border: 1px solid var(--border-light); border-radius: var(--radius-card); padding: 1.5rem 1.6rem; box-shadow: var(--shadow-sm); }

    .pv-review { background: #fff; border: 1.5px solid var(--border-light); border-left: 4px solid var(--primary); border-radius: var(--radius-md); padding: 1.1rem 1.3rem; margin-bottom: 0.85rem; }
    .pv-review-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 0.5rem; }
    .pv-review-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.92rem; display: flex; align-items: center; gap: 7px; }
    .pv-review-name i { color: var(--primary); font-size: 0.85rem; }
    .pv-review-rating { color: var(--cta); font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 4px; }
    .pv-review-text { color: #4B5563; font-size: 0.9rem; line-height: 1.7; margin: 0; word-break: break-word; }

    @media (max-width: 991px) {
      .pv-image-card { margin-bottom: 1.5rem; }
      .pv-main-image { max-height: 400px; }
      .pv-title { font-size: 1.5rem; }
      .pv-price { font-size: 1.75rem; }
    }

    @media (max-width: 767px) {
      .pv-page { padding-top: 100px; }
      .pv-main-image { max-height: 340px; }
      .pv-title { font-size: 1.35rem; }
      .pv-price { font-size: 1.6rem; }
      .pv-thumb { width: 62px; height: 62px; }
      .pv-specs th, .pv-specs td { padding: 10px 12px; font-size: 0.85rem; }
      .pv-specs th { font-size: 0.72rem; }
      .pv-section-heading { font-size: 1.05rem; }
      .pv-description { padding: 1.2rem; font-size: 0.9rem; }
    }

    @media (max-width: 575px) {
      .pv-image-card { padding: 0.75rem; border-radius: 16px; }
      .pv-main-image { max-height: 280px; border-radius: 12px; }
      .pv-image-placeholder { height: 260px; font-size: 2.5rem; }
      .pv-title { font-size: 1.2rem; }
      .pv-price { font-size: 1.45rem; }
      .pv-cart-form { flex-direction: column; }
      .pv-qty-input { max-width: 100%; }
      .pv-add-btn, .pv-unavailable { width: 100%; justify-content: center; }
      .pv-owner-actions { flex-direction: column; }
      .pv-btn-outline { width: 100%; justify-content: center; }
      .pv-thumb { width: 56px; height: 56px; }
      .pv-specs th { width: 45%; font-size: 0.68rem; }
      .pv-review { padding: 1rem 1.1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
<%- include('../partials/header') %>

<%
  const viewer = locals.user || null;
  const MAX_QTY_PER_ITEM = 100;

  const inr = (value) =>
    Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  const isOwner = Boolean(viewer && product.owner && String(product.owner._id) === String(viewer._id));
  const isAdmin = Boolean(viewer && String(viewer.role).toLowerCase() === 'admin');
  const isExpired = Boolean(product.expiryDate) && new Date(product.expiryDate).getTime() <= Date.now();
  const canBuy = Boolean(viewer) && !isOwner && product.isActive && product.approvalStatus === 'Approved' && product.stock > 0 && !isExpired;
  const maxQty = Math.max(1, Math.min(product.stock, MAX_QTY_PER_ITEM));

  const gallery = [product.image].concat(product.images || []).filter(Boolean).filter((url, index, all) => all.indexOf(url) === index);

  const categoryLabel = product.category === 'Other' ? product.customCategory : product.category;
  const showStatus = (isOwner || isAdmin) && product.approvalStatus !== 'Approved';
  const reviews = product.reviews || [];
%>

<main class="pv-page container">

  <a href="/products" class="pv-back"><i class="fas fa-arrow-left"></i> Back to marketplace</a>

  <% if (locals.success) { %>
    <div class="pv-alert pv-alert-success" role="status"><i class="fas fa-circle-check mt-1"></i><span><%= success %></span></div>
  <% } %>

  <% if (locals.error) { %>
    <div class="pv-alert pv-alert-danger" role="alert"><i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span></div>
  <% } %>

  <% if (showStatus) { %>
    <div class="pv-alert <%= product.approvalStatus === 'Rejected' ? 'pv-alert-danger' : 'pv-alert-warning' %>" role="status">
      <i class="fas <%= product.approvalStatus === 'Rejected' ? 'fa-circle-xmark' : 'fa-clock' %> mt-1"></i>
      <div>
        <% if (product.approvalStatus === 'Pending') { %>
          <% if (isOwner) { %>
            This product is awaiting admin approval and is not visible in the marketplace yet.
          <% } else { %>
            This product is waiting for approval. <a href="/admin/products?status=Pending">Review pending products</a>
          <% } %>
        <% } else { %>
          This product was rejected<%= product.rejectionReason ? ': ' + product.rejectionReason : '.' %>
          <% if (isOwner) { %>Edit it and it will be sent for review again.<% } %>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (isOwner && product.isActive === false) { %>
    <div class="pv-alert pv-alert-secondary" role="status">
      <i class="fas fa-eye-slash mt-1"></i><span>This product is inactive, so buyers cannot see it.</span>
    </div>
  <% } %>

  <% if (isExpired) { %>
    <div class="pv-alert pv-alert-secondary" role="status">
      <i class="fas fa-calendar-xmark mt-1"></i><span>This product has expired and cannot be bought.</span>
    </div>
  <% } %>

  <div class="row g-4">

    <div class="col-lg-6">
      <div class="pv-image-card">
        <% if (gallery.length) { %>
          <img id="mainImage" src="<%= gallery[0] %>" alt="<%= product.name %>" class="pv-main-image">

          <% if (gallery.length > 1) { %>
            <div class="pv-gallery" role="group" aria-label="Product photos">
              <% gallery.forEach((url, index) => { %>
                <button type="button" class="pv-thumb <%= index === 0 ? 'active' : '' %>" data-src="<%= url %>" aria-label="Show photo <%= index + 1 %>">
                  <img src="<%= url %>" alt="" loading="lazy">
                </button>
              <% }) %>
            </div>
          <% } %>
        <% } else { %>
          <div class="pv-image-placeholder"><i class="fas fa-image" aria-hidden="true"></i></div>
        <% } %>
      </div>
    </div>

    <div class="col-lg-6">

      <div class="pv-badges">
        <span class="pv-badge pv-badge-category"><i class="fas fa-tag"></i> <%= categoryLabel %></span>
        <% if (product.subCategory) { %><span class="pv-badge pv-badge-sub"><%= product.subCategory %></span><% } %>
      </div>

      <h1 class="pv-title"><%= product.name %></h1>

      <% if (product.brand) { %>
        <div class="pv-brand"><i class="fas fa-copyright"></i> <%= product.brand %></div>
      <% } %>

      <% if (product.numOfReviews > 0) { %>
        <div class="pv-rating">
          <span class="stars"><i class="fas fa-star"></i> <%= product.ratings %></span>
          <span class="text-muted">(<%= product.numOfReviews %> review<%= product.numOfReviews === 1 ? '' : 's' %>)</span>
        </div>
      <% } %>

      <div class="pv-price-row">
        <span class="pv-price">₹<%= inr(product.price) %></span>
        <% if (product.mrp > product.price) { %>
          <span class="pv-mrp">₹<%= inr(product.mrp) %></span>
          <span class="pv-discount"><i class="fas fa-fire me-1"></i><%= product.discount %>% OFF</span>
        <% } %>
      </div>

      <% if (product.tax > 0) { %>
        <div class="pv-tax-note"><i class="fas fa-circle-info me-1"></i>Inclusive of <%= product.tax %>% tax</div>
      <% } %>

      <div>
        <% if (product.stock > 0) { %>
          <% if (product.stock <= product.minStock) { %>
            <span class="pv-stock pv-stock-low"><i class="fas fa-triangle-exclamation"></i> Only <%= product.stock %> <%= product.unit %> left</span>
          <% } else { %>
            <span class="pv-stock pv-stock-in"><i class="fas fa-circle-check"></i> In stock (<%= product.stock %> <%= product.unit %> available)</span>
          <% } %>
        <% } else { %>
          <span class="pv-stock pv-stock-out"><i class="fas fa-circle-xmark"></i> Out of stock</span>
        <% } %>
      </div>

      <% if (product.shortDescription) { %>
        <p class="pv-short-desc"><%= product.shortDescription %></p>
      <% } %>

      <% if (canBuy) { %>
        <form action="/cart/<%= product._id %>/add" method="POST" class="pv-cart-form">
          <input type="number" name="quantity" value="1" min="1" max="<%= maxQty %>" class="pv-qty-input" aria-label="Quantity" inputmode="numeric">
          <button type="submit" class="pv-add-btn"><i class="fas fa-cart-plus"></i> Add to cart</button>
        </form>
      <% } else if (!isOwner) { %>
        <button type="button" class="pv-unavailable" disabled><i class="fas fa-ban"></i> Currently unavailable</button>
      <% } %>

      <% if (isOwner) { %>
        <div class="pv-owner-actions">
          <a href="/products/edit/<%= product._id %>" class="pv-btn-outline pv-btn-outline-primary"><i class="fas fa-pen"></i> Edit product</a>
          <form action="/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Delete this product? This cannot be undone.');">
            <input type="hidden" name="redirect" value="/<%= String(viewer.role).toLowerCase() %>/dashboard">
            <button type="submit" class="pv-btn-outline pv-btn-outline-danger"><i class="fas fa-trash"></i> Delete product</button>
          </form>
        </div>
      <% } else if (isAdmin) { %>
        <div class="pv-owner-actions">
          <a href="/admin/products" class="pv-btn-outline pv-btn-outline-primary"><i class="fas fa-list-check"></i> Manage products</a>
          <form action="/admin/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('Delete this product as admin? This cannot be undone.');">
            <input type="hidden" name="redirect" value="/admin/products">
            <button type="submit" class="pv-btn-outline pv-btn-outline-danger"><i class="fas fa-trash"></i> Delete as admin</button>
          </form>
        </div>
      <% } %>

      <table class="pv-specs">
        <tbody>
          <% if (product.weight) { %>
            <tr><th><i class="fas fa-weight-hanging me-1"></i>Weight</th><td><%= product.weight %> <%= product.weightUnit %></td></tr>
          <% } %>
          <% if (product.color) { %>
            <tr><th><i class="fas fa-palette me-1"></i>Colour</th><td><%= product.color %></td></tr>
          <% } %>
          <% if (product.size) { %>
            <tr><th><i class="fas fa-ruler me-1"></i>Size</th><td><%= product.size %></td></tr>
          <% } %>
          <% if (product.flavor) { %>
            <tr><th><i class="fas fa-ice-cream me-1"></i>Flavour</th><td><%= product.flavor %></td></tr>
          <% } %>
          <% if (product.manufactureDate) { %>
            <tr><th><i class="fas fa-industry me-1"></i>Manufactured on</th><td><%= new Date(product.manufactureDate).toLocaleDateString('en-IN') %></td></tr>
          <% } %>
          <% if (product.expiryDate) { %>
            <tr><th><i class="fas fa-calendar-xmark me-1"></i>Expires on</th><td><%= new Date(product.expiryDate).toLocaleDateString('en-IN') %></td></tr>
          <% } %>
          <tr>
            <th><i class="fas fa-truck me-1"></i>Shipping</th>
            <td>
              <% if (product.freeShipping) { %>
                <span style="color:#0369A1;font-weight:700;">Free</span>
              <% } else { %>
                ₹<%= inr(product.shippingCharge) %>
              <% } %>
              <% if (product.deliveryTime) { %><span class="text-muted"> · <%= product.deliveryTime %></span><% } %>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="pv-seller-card">
        <div class="pv-seller-title"><i class="fas fa-user-tie"></i> Seller information</div>

        <div class="pv-seller-name">
          <%= (product.seller && product.seller.name) || (product.owner && product.owner.fullName) || 'Seller' %>
        </div>

        <div class="pv-seller-role"><i class="fas fa-circle-check me-1"></i><%= product.ownerRole || 'Seller' %></div>

        <% if (product.seller && product.seller.phone) { %>
          <div class="pv-seller-info"><i class="fas fa-phone"></i><span><%= product.seller.phone %></span></div>
        <% } %>

        <% if (product.seller && product.seller.address) { %>
          <div class="pv-seller-info"><i class="fas fa-location-dot"></i><span><%= product.seller.address %></span></div>
        <% } %>
      </div>

    </div>
  </div>

  <div class="mt-5">
    <h2 class="pv-section-heading"><i class="fas fa-file-lines"></i> Description</h2>
    <div class="pv-description"><%= product.description %></div>
  </div>

  <% if (reviews.length) { %>
    <div class="mt-5">
      <h2 class="pv-section-heading"><i class="fas fa-comments"></i> Reviews (<%= product.numOfReviews || reviews.length %>)</h2>

      <% if (product.numOfReviews > reviews.length) { %>
        <p class="text-muted" style="font-size: 0.85rem;">Showing the latest <%= reviews.length %> reviews.</p>
      <% } %>

      <% reviews.slice().reverse().forEach((review) => { %>
        <div class="pv-review">
          <div class="pv-review-header">
            <div class="pv-review-name"><i class="fas fa-circle-user"></i> <%= review.name || 'Anonymous' %></div>
            <div class="pv-review-rating"><i class="fas fa-star"></i> <%= review.rating %></div>
          </div>
          <% if (review.comment) { %><p class="pv-review-text"><%= review.comment %></p><% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const navbar = document.querySelector('.navbar');

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 20);
    });
  }

  const mainImage = document.getElementById('mainImage');
  const thumbs = Array.from(document.querySelectorAll('.pv-thumb'));

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (!mainImage || mainImage.src === thumb.dataset.src) return;

      mainImage.style.opacity = '0.4';

      setTimeout(() => {
        mainImage.src = thumb.dataset.src;
        mainImage.style.opacity = '1';
      }, 120);

      thumbs.forEach((item) => item.classList.toggle('active', item === thumb));
    });
  });
</script>
</body>
</html>
