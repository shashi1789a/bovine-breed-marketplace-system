<%
  var isOwner = product.owner && String(product.owner._id) === String(user._id);
  var isAdmin = user.role === 'admin';
  var isExpired = product.expiryDate && new Date(product.expiryDate).getTime() <= Date.now();
  var canBuy = !isOwner && product.isActive && product.approvalStatus === 'Approved' && product.stock > 0 && !isExpired;
  var gallery = [product.image].concat(product.images || []).filter(Boolean);
%>

<%- include('../partials/header') %>

<style>
  /* ============================================================
     BOVINETRA PRODUCT VIEW PAGE — DESIGN SYSTEM
     Colors: Blue + Amber (matching main site)
     ============================================================ */
  :root {
    --primary: #0284C7;
    --primary-dark: #0C4A6E;
    --primary-light: #0EA5E9;
    --accent: #0EA5E9;
    --cta: #F59E0B;
    --cta-dark: #D97706;
    --light: #E0F2FE;
    --dark-bg: #082F49;
    --text-main: #111827;
    --text-muted: #6B7280;
    --border-light: rgba(2, 132, 199, 0.12);
    --gradient-hero: linear-gradient(135deg, #082F49 0%, #0C4A6E 45%, #0284C7 100%);
    --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
    --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
    --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.14);
    --radius-card: 20px;
    --radius-md: 16px;
    --radius-sm: 10px;
    --radius-pill: 50px;
    --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pv-page {
    background: #F4F9FE;
    min-height: 100vh;
  }

  /* ---------- Back link ---------- */
  .pv-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: var(--primary);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-pill);
    padding: 0.55rem 1.2rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: var(--transition);
    margin-bottom: 1.5rem;
  }

  .pv-back:hover {
    background: var(--light);
    border-color: var(--primary);
    color: var(--primary-dark);
    transform: translateX(-3px);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.15);
  }

  /* ---------- Alerts ---------- */
  .pv-alert {
    border: none;
    border-radius: var(--radius-md);
    padding: 0.95rem 1.2rem;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    animation: pvFadeIn 0.4s ease;
  }

  @keyframes pvFadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .pv-alert-danger {
    background: linear-gradient(135deg, #FEE2E2, #FECACA);
    color: #991B1B;
    border-left: 4px solid #EF4444;
  }

  .pv-alert-warning {
    background: linear-gradient(135deg, #FEF3C7, #FDE68A);
    color: #92400E;
    border-left: 4px solid var(--cta);
  }

  .pv-alert-secondary {
    background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
    color: var(--primary-dark);
    border-left: 4px solid var(--primary);
  }

  /* ---------- Image Panel ---------- */
  .pv-image-card {
    background: #fff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-card);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    animation: pvFadeIn 0.5s ease 0.05s both;
  }

  .pv-image-card:hover {
    box-shadow: var(--shadow-md);
  }

  .pv-main-image {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-light);
    transition: var(--transition);
    background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
  }

  .pv-main-image:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 32px rgba(2, 132, 199, 0.18);
  }

  .pv-image-placeholder {
    height: 340px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
    border: 1.5px dashed rgba(2, 132, 199, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #BAE6FD;
    font-size: 3rem;
  }

  /* Gallery */
  .pv-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 0.85rem;
  }

  .pv-thumb {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 2px solid var(--border-light);
    cursor: pointer;
    transition: var(--transition);
    background: #F8FDFF;
  }

  .pv-thumb:hover {
    border-color: var(--primary);
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.25);
  }

  .pv-thumb.active {
    border-color: var(--cta);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
  }

  /* ---------- Right Panel ---------- */
  .pv-details {
    animation: pvFadeIn 0.5s ease 0.1s both;
  }

  .pv-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 0.85rem;
  }

  .pv-badge {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.68rem;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .pv-badge-category {
    background: var(--gradient-primary);
    color: #fff;
    box-shadow: 0 3px 10px rgba(2, 132, 199, 0.28);
  }

  .pv-badge-sub {
    background: #F0F9FF;
    color: var(--primary-dark);
    border: 1px solid rgba(2, 132, 199, 0.18);
  }

  .pv-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 1.7rem;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .pv-brand {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pv-brand i { color: var(--primary); }

  .pv-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
    font-size: 0.88rem;
  }

  .pv-rating .stars { color: var(--cta); }

  .pv-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 0.5rem;
  }

  .pv-price {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 2rem;
    color: var(--primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .pv-mrp {
    color: #9ca3af;
    text-decoration: line-through;
    font-size: 1rem;
    font-weight: 500;
  }

  .pv-discount {
    background: var(--gradient-cta);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.32);
  }

  .pv-tax-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  /* Stock */
  .pv-stock {
    font-size: 0.86rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .pv-stock-in {
    color: #0284C7;
    background: rgba(2, 132, 199, 0.1);
  }

  .pv-stock-low {
    color: #D97706;
    background: rgba(245, 158, 11, 0.12);
  }

  .pv-stock-out {
    color: #DC2626;
    background: rgba(220, 38, 38, 0.1);
  }

  .pv-short-desc {
    color: #4B5563;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  /* Add-to-cart */
  .pv-cart-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .pv-qty-input {
    max-width: 100px;
    background: #F8FDFF;
    border: 1.5px solid #E2EDF7;
    border-radius: 14px;
    padding: 11px 14px;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    text-align: center;
    transition: var(--transition);
  }

  .pv-qty-input:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.14);
    background: #fff;
  }

  .pv-add-btn {
    background: var(--gradient-cta);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.8rem;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.38);
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .pv-add-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(245, 158, 11, 0.5);
    color: #fff;
  }

  .pv-unavailable {
    background: linear-gradient(135deg, #6B7280, #9CA3AF);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.8rem;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: not-allowed;
    opacity: 0.7;
    margin-bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Owner actions */
  .pv-owner-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .pv-btn-outline {
    background: #fff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-pill);
    padding: 0.6rem 1.4rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    transition: var(--transition);
    cursor: pointer;
  }

  .pv-btn-outline-primary {
    color: var(--primary);
    border-color: rgba(2, 132, 199, 0.3);
  }
  .pv-btn-outline-primary:hover {
    background: var(--light);
    border-color: var(--primary);
    color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.15);
  }

  .pv-btn-outline-danger {
    color: #DC2626;
    border-color: rgba(220, 38, 38, 0.3);
  }
  .pv-btn-outline-danger:hover {
    background: #FEE2E2;
    border-color: #DC2626;
    color: #991B1B;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(220, 38, 38, 0.15);
  }

  /* ---------- Specs Table ---------- */
  .pv-specs {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1.5px solid var(--border-light);
    margin-bottom: 1.5rem;
  }

  .pv-specs tr {
    transition: background 0.2s ease;
  }

  .pv-specs tr:hover {
    background: #F8FDFF;
  }

  .pv-specs th {
    background: #F0F9FF;
    color: var(--primary-dark);
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 11px 16px;
    width: 42%;
    border-bottom: 1px solid rgba(2, 132, 199, 0.1);
    vertical-align: middle;
  }

  .pv-specs td {
    padding: 11px 16px;
    color: var(--text-main);
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(2, 132, 199, 0.08);
    vertical-align: middle;
  }

  .pv-specs tr:last-child th,
  .pv-specs tr:last-child td {
    border-bottom: none;
  }

  /* ---------- Seller Card ---------- */
  .pv-seller-card {
    background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
    border: 1.5px solid rgba(2, 132, 199, 0.15);
    border-radius: var(--radius-md);
    padding: 1.3rem 1.4rem;
    transition: var(--transition);
  }

  .pv-seller-card:hover {
    box-shadow: 0 8px 22px rgba(2, 132, 199, 0.12);
    transform: translateY(-2px);
  }

  .pv-seller-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pv-seller-title i {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 0.78rem;
    border: 1px solid rgba(2, 132, 199, 0.18);
  }

  .pv-seller-name {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 4px;
  }

  .pv-seller-role {
    font-size: 0.78rem;
    color: var(--primary);
    text-transform: capitalize;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .pv-seller-info {
    font-size: 0.84rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 4px;
  }

  .pv-seller-info i {
    color: var(--primary);
    font-size: 0.78rem;
    width: 14px;
  }

  /* ---------- Section Headings ---------- */
  .pv-section-heading {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text-main);
    margin: 2rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pv-section-heading i {
    color: var(--primary);
    font-size: 1rem;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(2, 132, 199, 0.15);
  }

  .pv-description {
    font-size: 0.95rem;
    color: #4B5563;
    line-height: 1.8;
    white-space: pre-line;
    background: #fff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--shadow-sm);
  }

  /* ---------- Reviews ---------- */
  .pv-review {
    background: #fff;
    border: 1.5px solid var(--border-light);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.3rem;
    margin-bottom: 0.85rem;
    transition: var(--transition);
    animation: pvFadeIn 0.4s ease both;
  }

  .pv-review:hover {
    box-shadow: 0 8px 22px rgba(2, 132, 199, 0.1);
    transform: translateX(3px);
    border-left-color: var(--cta);
  }

  .pv-review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 0.5rem;
  }

  .pv-review-name {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: var(--text-main);
    font-size: 0.92rem;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .pv-review-name i {
    color: var(--primary);
    font-size: 0.85rem;
  }

  .pv-review-rating {
    color: var(--cta);
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pv-review-text {
    color: #4B5563;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 991px) {
    .pv-image-card { margin-bottom: 1.5rem; }
    .pv-main-image { max-height: 400px; }
    .pv-title { font-size: 1.5rem; }
    .pv-price { font-size: 1.75rem; }
  }

  @media (max-width: 767px) {
    .pv-back { font-size: 0.82rem; padding: 0.5rem 1rem; }
    .pv-main-image { max-height: 340px; }
    .pv-title { font-size: 1.35rem; }
    .pv-price { font-size: 1.6rem; }
    .pv-thumb { width: 62px; height: 62px; }
    .pv-specs th,
    .pv-specs td { padding: 10px 12px; font-size: 0.85rem; }
    .pv-specs th { font-size: 0.72rem; }
    .pv-section-heading { font-size: 1.05rem; }
    .pv-section-heading i { width: 30px; height: 30px; font-size: 0.9rem; }
    .pv-description { padding: 1.2rem 1.2rem; font-size: 0.9rem; }
  }

  @media (max-width: 575px) {
    .pv-image-card { padding: 0.75rem; border-radius: 16px; }
    .pv-main-image { max-height: 280px; border-radius: 12px; }
    .pv-image-placeholder { height: 260px; font-size: 2.5rem; }
    .pv-title { font-size: 1.2rem; }
    .pv-price { font-size: 1.45rem; }
    .pv-mrp { font-size: 0.9rem; }
    .pv-cart-form { flex-direction: column; }
    .pv-qty-input { max-width: 100%; }
    .pv-add-btn { width: 100%; justify-content: center; }
    .pv-unavailable { width: 100%; justify-content: center; }
    .pv-owner-actions { flex-direction: column; }
    .pv-btn-outline { width: 100%; justify-content: center; }
    .pv-thumb { width: 56px; height: 56px; }
    .pv-specs th,
    .pv-specs td { padding: 9px 11px; font-size: 0.82rem; }
    .pv-specs th { width: 45%; font-size: 0.68rem; }
    .pv-section-heading { font-size: 1rem; }
    .pv-description { padding: 1rem 1.1rem; font-size: 0.86rem; }
    .pv-review { padding: 1rem 1.1rem; }
    .pv-review-name { font-size: 0.86rem; }
    .pv-review-text { font-size: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<main class="pv-page container" style="padding-top: 120px; padding-bottom: 60px;">

  <a href="/products" class="pv-back">
    <i class="fas fa-arrow-left"></i> Back to marketplace
  </a>

  <!-- Approval status alerts for owner -->
  <% if (isOwner && product.approvalStatus !== 'Approved') { %>
    <div class="pv-alert <%= product.approvalStatus === 'Rejected' ? 'pv-alert-danger' : 'pv-alert-warning' %>">
      <i class="fas <%= product.approvalStatus === 'Rejected' ? 'fa-times-circle' : 'fa-clock' %>"></i>
      <div>
        <% if (product.approvalStatus === 'Pending') { %>
          This product is awaiting admin approval and is not yet visible in the marketplace.
        <% } else { %>
          This product was rejected<%= product.rejectionReason ? ': ' + product.rejectionReason : '.' %>
          Edit and resubmit it for review.
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Expiry alert -->
  <% if (isExpired) { %>
    <div class="pv-alert pv-alert-secondary">
      <i class="fas fa-calendar-times"></i>
      <span>This product has expired.</span>
    </div>
  <% } %>

  <div class="row g-4">

    <!-- ============ LEFT: IMAGES ============ -->
    <div class="col-lg-6">
      <div class="pv-image-card">

        <% if (gallery.length) { %>

          <img id="mainImage" src="<%= gallery[0] %>" alt="<%= product.name %>"
               class="pv-main-image">

          <% if (gallery.length > 1) { %>
            <div class="pv-gallery">
              <% gallery.forEach(function (url, idx) { %>
                <img src="<%= url %>" alt=""
                     class="pv-thumb <%= idx === 0 ? 'active' : '' %>"
                     onclick="swapImage(this, '<%= url %>')">
              <% }) %>
            </div>
          <% } %>

        <% } else { %>

          <div class="pv-image-placeholder">
            <i class="fas fa-image"></i>
          </div>

        <% } %>

      </div>
    </div>

    <!-- ============ RIGHT: DETAILS ============ -->
    <div class="col-lg-6">
      <div class="pv-details">

        <!-- Badges -->
        <div class="pv-badges">
          <span class="pv-badge pv-badge-category">
            <i class="fas fa-tag"></i>
            <%= product.category === 'Other' ? product.customCategory : product.category %>
          </span>
          <% if (product.subCategory) { %>
            <span class="pv-badge pv-badge-sub"><%= product.subCategory %></span>
          <% } %>
        </div>

        <!-- Title -->
        <h1 class="pv-title"><%= product.name %></h1>

        <% if (product.brand) { %>
          <div class="pv-brand">
            <i class="fas fa-copyright"></i> <%= product.brand %>
          </div>
        <% } %>

        <!-- Rating -->
        <% if (product.numOfReviews > 0) { %>
          <div class="pv-rating">
            <span class="stars">
              <i class="fas fa-star"></i> <%= product.ratings %>
            </span>
            <span class="text-muted">
              (<%= product.numOfReviews %> review<%= product.numOfReviews === 1 ? '' : 's' %>)
            </span>
          </div>
        <% } %>

        <!-- Price -->
        <div class="pv-price-row">
          <span class="pv-price">₹<%= product.price %></span>
          <% if (product.mrp > product.price) { %>
            <span class="pv-mrp">₹<%= product.mrp %></span>
            <span class="pv-discount">
              <i class="fas fa-fire me-1"></i><%= product.discount %>% OFF
            </span>
          <% } %>
        </div>

        <% if (product.tax > 0) { %>
          <div class="pv-tax-note">
            <i class="fas fa-info-circle me-1"></i>Inclusive of <%= product.tax %>% tax
          </div>
        <% } %>

        <!-- Stock -->
        <div>
          <% if (product.stock > 0) { %>
            <% if (product.stock <= product.minStock) { %>
              <span class="pv-stock pv-stock-low">
                <i class="fas fa-exclamation-triangle"></i>
                Only <%= product.stock %> <%= product.unit %> left
              </span>
            <% } else { %>
              <span class="pv-stock pv-stock-in">
                <i class="fas fa-check-circle"></i>
                In stock (<%= product.stock %> <%= product.unit %> available)
              </span>
            <% } %>
          <% } else { %>
            <span class="pv-stock pv-stock-out">
              <i class="fas fa-times-circle"></i> Out of stock
            </span>
          <% } %>
        </div>

        <!-- Short description -->
        <p class="pv-short-desc">
          <%= product.shortDescription || product.description %>
        </p>

        <!-- Add to cart -->
        <% if (canBuy) { %>
          <form action="/cart/<%= product._id %>/add" method="POST" class="pv-cart-form">
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="pv-qty-input">
            <button type="submit" class="pv-add-btn">
              <i class="fas fa-cart-plus"></i> Add to Cart
            </button>
          </form>
        <% } else if (!isOwner) { %>
          <button class="pv-unavailable" disabled>
            <i class="fas fa-ban"></i> Currently Unavailable
          </button>
        <% } %>

        <!-- Owner / Admin actions -->
        <% if (isOwner || isAdmin) { %>
          <div class="pv-owner-actions">
            <a href="/products/edit/<%= product._id %>" class="pv-btn-outline pv-btn-outline-primary">
              <i class="fas fa-pen"></i> Edit Product
            </a>
            <form action="/products/delete/<%= product._id %>" method="POST"
                  onsubmit="return confirm('Delete this product? This cannot be undone.');">
              <button type="submit" class="pv-btn-outline pv-btn-outline-danger">
                <i class="fas fa-trash"></i> Delete Product
              </button>
            </form>
          </div>
        <% } %>

        <!-- Specs Table -->
        <table class="pv-specs">
          <tbody>
            <% if (product.weight) { %>
              <tr>
                <th><i class="fas fa-weight-hanging me-1"></i>Weight</th>
                <td><%= product.weight %> <%= product.weightUnit %></td>
              </tr>
            <% } %>
            <% if (product.color) { %>
              <tr>
                <th><i class="fas fa-palette me-1"></i>Color</th>
                <td><%= product.color %></td>
              </tr>
            <% } %>
            <% if (product.size) { %>
              <tr>
                <th><i class="fas fa-ruler me-1"></i>Size</th>
                <td><%= product.size %></td>
              </tr>
            <% } %>
            <% if (product.flavor) { %>
              <tr>
                <th><i class="fas fa-ice-cream me-1"></i>Flavor</th>
                <td><%= product.flavor %></td>
              </tr>
            <% } %>
            <% if (product.manufactureDate) { %>
              <tr>
                <th><i class="fas fa-industry me-1"></i>Manufactured On</th>
                <td><%= new Date(product.manufactureDate).toLocaleDateString('en-IN') %></td>
              </tr>
            <% } %>
            <% if (product.expiryDate) { %>
              <tr>
                <th><i class="fas fa-calendar-times me-1"></i>Expires On</th>
                <td><%= new Date(product.expiryDate).toLocaleDateString('en-IN') %></td>
              </tr>
            <% } %>
            <tr>
              <th><i class="fas fa-truck me-1"></i>Shipping</th>
              <td>
                <% if (product.freeShipping) { %>
                  <span style="color:#0284C7;font-weight:700;">Free</span>
                <% } else { %>
                  ₹<%= product.shippingCharge %>
                <% } %>
                <% if (product.deliveryTime) { %>
                  <span class="text-muted"> · <%= product.deliveryTime %></span>
                <% } %>
              </td>
            </tr>
          </tbody>
        </table>

        <!-- Seller Card -->
        <div class="pv-seller-card">
          <div class="pv-seller-title">
            <i class="fas fa-user-tie"></i> Seller Information
          </div>

          <div class="pv-seller-name">
            <%= (product.seller && product.seller.name) || (product.owner && product.owner.fullName) || 'Seller' %>
          </div>

          <div class="pv-seller-role">
            <i class="fas fa-badge-check me-1"></i><%= product.ownerRole || 'Seller' %>
          </div>

          <% if (product.seller && product.seller.phone) { %>
            <div class="pv-seller-info">
              <i class="fas fa-phone"></i>
              <span><%= product.seller.phone %></span>
            </div>
          <% } %>

          <% if (product.seller && product.seller.address) { %>
            <div class="pv-seller-info">
              <i class="fas fa-location-dot"></i>
              <span><%= product.seller.address %></span>
            </div>
          <% } %>
        </div>

      </div>
    </div>

  </div>

  <!-- ============ DESCRIPTION ============ -->
  <div class="mt-5">
    <h2 class="pv-section-heading">
      <i class="fas fa-file-alt"></i> Description
    </h2>
    <div class="pv-description"><%= product.description %></div>
  </div>

  <!-- ============ REVIEWS ============ -->
  <% if ((product.reviews || []).length) { %>
    <div class="mt-5">
      <h2 class="pv-section-heading">
        <i class="fas fa-comments"></i> Reviews (<%= product.reviews.length %>)
      </h2>

      <% product.reviews.slice().reverse().forEach(function (review, idx) { %>
        <div class="pv-review" style="animation-delay: <%= idx * 0.05 %>s;">
          <div class="pv-review-header">
            <div class="pv-review-name">
              <i class="fas fa-user-circle"></i>
              <%= review.name || 'Anonymous' %>
            </div>
            <div class="pv-review-rating">
              <i class="fas fa-star"></i> <%= review.rating %>
            </div>
          </div>
          <% if (review.comment) { %>
            <p class="pv-review-text"><%= review.comment %></p>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

</main>

<script>
  function swapImage(thumbEl, url) {
    const main = document.getElementById('mainImage');
    if (!main) return;

    // Fade transition
    main.style.opacity = '0.4';
    setTimeout(() => {
      main.src = url;
      main.style.opacity = '1';
    }, 120);

    // Update active state on thumbnails
    document.querySelectorAll('.pv-thumb').forEach(t => t.classList.remove('active'));
    thumbEl.classList.add('active');
  }
</script>

<%- include('../partials/footer') %>