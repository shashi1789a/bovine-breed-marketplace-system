<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'Orders' %> | BoviNetra</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0F62AC;
      --text-main: #1A2C3E;
      --text-muted: #5A6E7F;
      --border-light: rgba(15, 98, 172, 0.12);
      --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.02);
      --transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body { font-family: 'Inter', sans-serif; background: #F4F9FE; color: var(--text-main); line-height: 1.5; overflow-x: hidden; }
    h1, h2, h3, h4, h5 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .orders-page { padding: 110px 0 70px; min-height: 100vh; }

    .page-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 1.2rem; }
    .page-head h2 { font-size: 1.7rem; margin: 0; }
    .page-head p { color: var(--text-muted); font-size: 0.88rem; margin: 2px 0 0; }

    .filter-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1.4rem; }
    .filter-tabs a { padding: 7px 18px; border-radius: 40px; border: 1.5px solid #E2EDF7; background: #fff; color: var(--text-main); font-size: 0.84rem; font-weight: 600; text-decoration: none; transition: var(--transition); }
    .filter-tabs a:hover { border-color: var(--primary); color: var(--primary); }
    .filter-tabs a.active { background: var(--primary); border-color: var(--primary); color: #fff; }

    .order-card { background: #fff; border-radius: 22px; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); padding: 1.3rem 1.5rem; margin-bottom: 1.1rem; }

    .order-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; padding-bottom: 0.9rem; border-bottom: 1px solid #EEF4FA; }
    .order-top h5 { font-size: 1rem; margin: 0; word-break: break-all; }
    .order-top small { color: var(--text-muted); font-size: 0.8rem; }
    .badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .badge-status { font-weight: 600; padding: 0.35rem 0.9rem; border-radius: 40px; font-size: 0.73rem; }

    .order-items { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 0.9rem 0; }
    .thumb { width: 52px; height: 52px; border-radius: 14px; background: #EAF3FB; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #94A3B8; flex-shrink: 0; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .more-items { font-size: 0.82rem; color: var(--text-muted); font-weight: 600; }
    .item-names { flex: 1; min-width: 180px; font-size: 0.86rem; color: var(--text-muted); }
    .item-names strong { color: var(--text-main); }

    .order-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .order-meta { font-size: 0.84rem; color: var(--text-muted); }
    .order-meta strong { color: var(--text-main); font-size: 1.02rem; font-family: 'Plus Jakarta Sans', sans-serif; }

    .btn-main, .btn-soft { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 18px; border-radius: 40px; font-weight: 600; font-size: 0.83rem; text-decoration: none; cursor: pointer; transition: var(--transition); }
    .btn-main { border: none; background: var(--primary); color: #fff; }
    .btn-main:hover { background: #0B4F8C; color: #fff; }
    .btn-soft { border: 1.5px solid #E2EDF7; background: #fff; color: var(--text-main); }
    .btn-soft:hover { border-color: var(--primary); color: var(--primary); }
    .btn-soft.disabled { opacity: 0.45; pointer-events: none; }

    .empty-orders { text-align: center; background: #fff; border-radius: 24px; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); padding: 3.5rem 1.5rem; }
    .empty-orders i { width: 76px; height: 76px; border-radius: 50%; background: rgba(15, 98, 172, 0.08); color: var(--primary); font-size: 1.8rem; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .empty-orders h3 { font-size: 1.35rem; margin-bottom: 6px; }
    .empty-orders p { color: var(--text-muted); margin-bottom: 0; }

    .pager { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 1.6rem; font-size: 0.86rem; color: var(--text-muted); }

    .alert-modern { display: flex; align-items: flex-start; gap: 10px; border-radius: 16px; padding: 12px 16px; font-size: 0.88rem; font-weight: 500; margin-bottom: 1.2rem; }
    .alert-error { background: #FEE2E2; color: #B91C1C; }
    .alert-success { background: #DCFCE7; color: #166534; }

    @media (max-width: 575px) {
      .orders-page { padding: 95px 0 50px; }
      .order-card { padding: 1.1rem; }
    }
  </style>
</head>
<body>
<%- include('../partials/header') %>

<%
  const inr = (value) =>
    Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  const formatDate = (value) =>
    value
      ? new Date(value).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
      : '';

  const orderClass = { Pending: 'bg-warning text-dark', Placed: 'bg-info text-dark', Shipped: 'bg-primary', Delivered: 'bg-success', Cancelled: 'bg-secondary' };
  const paymentClass = { Paid: 'bg-success', Pending: 'bg-warning text-dark', Initiated: 'bg-warning text-dark', Failed: 'bg-danger', Refunded: 'bg-info text-dark' };
  const methodLabel = { COD: 'Cash on Delivery', RAZORPAY: 'Online' };

  /* Seller pages live under /farmer or /doctor, depending on who is logged in. */
  const base = '/' + (locals.user && locals.user.role === 'doctor' ? 'doctor' : 'farmer');

  const activeStatus = (locals.filters && locals.filters.status) || '';
  const statusList = locals.statuses || ['Placed', 'Shipped', 'Delivered', 'Cancelled'];
  const list = locals.orders || [];
  const paging = locals.pagination || { page: 1, totalPages: 1, total: list.length, hasPrev: false, hasNext: false };

  const pageUrl = (page) =>
    base + '/orders?' + (activeStatus ? 'status=' + encodeURIComponent(activeStatus) + '&' : '') + 'page=' + page;
%>

<main class="orders-page">
  <div class="container">

    <div class="page-head">
      <div>
        <h2>Orders</h2>
        <p><%= paging.total %> order<%= paging.total === 1 ? '' : 's' %><%= activeStatus ? ' · ' + activeStatus : ' in total' %></p>
      </div>
    </div>

    <% if (locals.success) { %>
      <div class="alert-modern alert-success" role="status"><i class="fas fa-circle-check mt-1"></i><span><%= success %></span></div>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert-modern alert-error" role="alert"><i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span></div>
    <% } %>

    <nav class="filter-tabs" aria-label="Filter orders by status">
      <a href="<%= base %>/orders" class="<%= activeStatus ? '' : 'active' %>">All</a>
      <% statusList.forEach(status => { %>
        <a href="<%= base %>/orders?status=<%= encodeURIComponent(status) %>" class="<%= activeStatus === status ? 'active' : '' %>"><%= status %></a>
      <% }) %>
    </nav>

    <% if (!list.length) { %>

      <div class="empty-orders">
        <i class="fas fa-box-open"></i>
        <h3>No orders yet</h3>
        <p><%= activeStatus ? 'No ' + activeStatus.toLowerCase() + ' orders right now.' : 'When buyers order your products, they will show up here.' %></p>
      </div>

    <% } else { %>

      <% list.forEach(order => {
           const items = order.items || [];
           const shown = items.slice(0, 3);
           const extra = items.length - shown.length;
           const units = items.reduce((sum, item) => sum + (item.quantity || 0), 0);
           const buyerName = (order.user && order.user.fullName) || (order.shippingAddress && order.shippingAddress.fullName) || 'Buyer';
      %>
        <article class="order-card">
          <div class="order-top">
            <div>
              <h5><%= order.orderNumber %></h5>
              <small><%= formatDate(order.placedAt || order.createdAt) %> &middot; <%= buyerName %></small>
            </div>
            <div class="badges">
              <span class="badge <%= orderClass[order.orderStatus] || 'bg-secondary' %> badge-status"><%= order.orderStatus %></span>
              <span class="badge <%= paymentClass[order.paymentStatus] || 'bg-secondary' %> badge-status"><%= order.paymentStatus %></span>
            </div>
          </div>

          <div class="order-items">
            <% shown.forEach(item => { %>
              <div class="thumb" title="<%= item.name %>">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                <% } else { %>
                  <i class="fas fa-box-open"></i>
                <% } %>
              </div>
            <% }) %>
            <% if (extra > 0) { %><span class="more-items">+<%= extra %> more</span><% } %>

            <div class="item-names">
              <strong><%= items[0] ? items[0].name : '' %></strong>
              <% if (items.length > 1) { %> and <%= items.length - 1 %> other item<%= items.length - 1 === 1 ? '' : 's' %><% } %>
            </div>
          </div>

          <div class="order-bottom">
            <div class="order-meta">
              <%= units %> unit<%= units === 1 ? '' : 's' %> &middot; <%= methodLabel[order.paymentMethod] || order.paymentMethod %><br>
              Total <strong>₹ <%= inr(order.totalAmount) %></strong>
            </div>

            <a href="<%= base %>/orders/<%= order._id %>" class="btn-main">
              <i class="fas fa-eye"></i> View Details
            </a>
          </div>
        </article>
      <% }) %>

      <% if (paging.totalPages > 1) { %>
        <div class="pager">
          <a href="<%= pageUrl(paging.page - 1) %>" class="btn-soft <%= paging.hasPrev ? '' : 'disabled' %>">
            <i class="fas fa-arrow-left"></i> Previous
          </a>
          <span>Page <%= paging.page %> of <%= paging.totalPages %></span>
          <a href="<%= pageUrl(paging.page + 1) %>" class="btn-soft <%= paging.hasNext ? '' : 'disabled' %>">
            Next <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      <% } %>

    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const navbar = document.querySelector('.navbar');

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 20);
    });
  }
</script>
</body>
</html>
