<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'Add Cattle' %> | BoviNetra</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
</head>
<body>
<%- include('../../partials/header') %>

<main class="form-page">
  <div class="container">
    <a href="/farmer/cattle" class="back-link"><i class="fas fa-arrow-left"></i> Back to my cattle</a>

    <div class="page-head">
      <h2>Add cattle</h2>
      <p>Only the breed name and category are required. The more you add, the more buyers trust the listing.</p>
    </div>

    <% if (locals.error) { %>
      <div class="alert-modern" role="alert" id="formError">
        <i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span>
      </div>
    <% } %>

    <%- include('_form', { mode: 'create' }) %>
  </div>
</main>

<%- include('../../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const navbar = document.querySelector('.navbar');

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 20);
    });
  }

  const formError = document.getElementById('formError');

  if (formError) formError.scrollIntoView({ block: 'center' });
</script>
</body>
</html>
