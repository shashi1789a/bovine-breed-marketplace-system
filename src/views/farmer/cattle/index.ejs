<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'My Cattle' %> | BoviNetra</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0F62AC;
      --text-main: #1A2C3E;
      --text-muted: #5A6E7F;
      --border-light: rgba(15, 98, 172, 0.12);
      --gradient-cta: linear-gradient(105deg, #F39C12, #E67E22);
      --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.02);
      --shadow-cta: 0 12px 28px -8px rgba(243, 156, 18, 0.4);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body { font-family: 'Inter', sans-serif; background: #F4F9FE; color: var(--text-main); line-height: 1.5; overflow-x: hidden; }
    h2, h3, h4 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .list-page { padding: 110px 0 70px; min-height: 100vh; }

    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--primary); text-decoration: none; font-size: 0.86rem; font-weight: 600; margin-bottom: 1rem; }

    .page-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 1.4rem; }
    .page-head h2 { font-size: 1.7rem; margin: 0; }
    .page-head p { color: var(--text-muted); font-size: 0.88rem; margin: 2px 0 0; }

    .btn-cta { display: inline-flex; align-items: center; gap: 8px; padding: 11px 26px; border-radius: 44px; background: var(--gradient-cta); color: #fff; font-weight: 700; font-size: 0.9rem; text-decoration: none; box-shadow: var(--shadow-cta); }
    .btn-cta:hover { color: #fff; filter: brightness(1.05); }

    .btn-soft { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 18px; border-radius: 40px; border: 1.5px solid #E2EDF7; background: #fff; color: var(--text-main); font-weight: 600; font-size: 0.82rem; text-decoration: none; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
    .btn-soft:hover { border-color: var(--primary); color: var(--primary); }
    .btn-soft.danger { color: #B91C1C; }
    .btn-soft.danger:hover { border-color: #B91C1C; color: #B91C1C; }
    .btn-soft.disabled { opacity: 0.45; pointer-events: none; }

    .alert-modern { display: flex; align-items: flex-start; gap: 10px; border-radius: 16px; padding: 12px 16px; font-size: 0.88rem; font-weight: 500; margin-bottom: 1.2rem; }
    .alert-error { background: #FEE2E2; color: #B91C1C; }
    .alert-success { background: #DCFCE7; color: #166534; }

    .filters { background: #fff; border: 1px solid var(--border-light); border-radius: 22px; box-shadow: var(--shadow-sm); padding: 1.1rem 1.3rem; margin-bottom: 1.5rem; }
    .filter-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 0.8rem; }
    .filter-grid .field label { display: block; font-size: 0.74rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
    .filter-grid input, .filter-grid select { width: 100%; background: #fff; border: 1.5px solid #E2EDF7; border-radius: 12px; padding: 8px 12px; font-size: 0.88rem; color: var(--text-main); }
    .filter-grid input:focus, .filter-grid select:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px rgba(15, 98, 172, 0.12); }
    .filter-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 0.9rem; }

    .cattle-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }

    .cattle-card { background: #fff; border: 1px solid var(--border-light); border-radius: 22px; box-shadow: var(--shadow-sm); overflow: hidden; display: flex; flex-direction: column; }

    .cover { position: relative; display: flex; align-items: center; justify-content: center; height: 190px; background: #EAF3FB; color: #94A3B8; font-size: 2.6rem; text-decoration: none; }
    .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tags { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
    .tag { font-size: 0.7rem; font-weight: 700; padding: 4px 11px; border-radius: 30px; color: #fff; }
    .tag.available { background: #16A34A; }
    .tag.sold { background: #475569; }
    .tag.unlisted { background: #B45309; }

    .card-body { display: flex; flex-direction: column; gap: 4px; padding: 1.1rem 1.2rem 1.2rem; flex: 1; }
    .kind { font-size: 0.78rem; font-weight: 600; color: var(--primary); }
    .title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.05rem; color: var(--text-main); text-decoration: none; word-break: break-word; }
    .title:hover { color: var(--primary); }
    .sub { font-size: 0.8rem; color: var(--text-muted); }

    .facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 0.5rem 0 0.2rem; }
    .fact { font-size: 0.74rem; font-weight: 600; background: #F0F6FC; color: #334E68; padding: 3px 10px; border-radius: 30px; }

    .price { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.2rem; margin: 0.5rem 0 0.9rem; }
    .price.empty { font-size: 0.9rem; font-weight: 600; color: var(--text-muted); }

    .card-actions { display: flex; gap: 8px; margin-top: auto; }
    .card-actions form { margin: 0; }
    .card-actions .btn-soft { padding: 7px 14px; }

    .empty-state { text-align: center; padding: 4rem 1.5rem; background: #fff; border: 1px solid var(--border-light); border-radius: 24px; box-shadow: var(--shadow-sm); }
    .empty-state .icon { width: 84px; height: 84px; border-radius: 50%; background: #EAF3FB; color: var(--primary); display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 1.1rem; }
    .empty-state h3 { font-size: 1.35rem; margin-bottom: 6px; }
    .empty-state p { color: var(--text-muted); margin-bottom: 1.3rem; }

    .pager { display: flex; justify-content: center; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 1.8rem; }
    .pager span { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }

    @media (max-width: 991px) { .filter-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 575px) {
      .list-page { padding: 95px 0 50px; }
      .filter-grid { grid-template-columns: 1fr; }
      .filter-actions .btn-soft { flex: 1; }
      .btn-cta { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
<%- include('../../partials/header') %>

<%
  const inr = (value) =>
    Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  const hasValue = (value) => value !== undefined && value !== null && value !== '';

  const formatAge = (months) => {
    const total = Number(months);
    if (!Number.isFinite(total)) return '';
    if (total < 12) return total + ' mo';
    const years = Math.floor(total / 12);
    const rest = Math.round(total % 12);
    return years + ' yr' + (rest ? ' ' + rest + ' mo' : '');
  };

  const f = locals.filters || {};
  const pageInfo = locals.pagination || { page: 1, totalPages: 1, hasNext: false, hasPrev: false, total: 0 };
  const categoryOptions = locals.categories || ['Cow', 'Buffalo'];
  const breedTypes = ['Milch', 'Dual-purpose', 'Draught'];
  const sorts = [
    ['newest', 'Newest first'],
    ['oldest', 'Oldest first'],
    ['price_asc', 'Price: low to high'],
    ['price_desc', 'Price: high to low'],
    ['milk_desc', 'Milk yield: high to low']
  ];

  const hasFilters = ['q', 'category', 'breedType', 'originState', 'minPrice', 'maxPrice', 'sold'].some((key) => hasValue(f[key]));

  const pageLink = (page) => {
    const params = new URLSearchParams();
    Object.entries(f).forEach(([key, value]) => {
      if (hasValue(value)) params.set(key, value);
    });
    params.set('page', page);
    return '/farmer/cattle?' + params.toString();
  };
%>

<main class="list-page">
  <div class="container">

    <a href="/farmer/dashboard" class="back-link"><i class="fas fa-arrow-left"></i> Back to dashboard</a>

    <div class="page-head">
      <div>
        <h2>My cattle</h2>
        <p><%= pageInfo.total %> <%= hasFilters ? 'matching' : 'total' %> listing<%= pageInfo.total === 1 ? '' : 's' %></p>
      </div>
      <a href="/farmer/cattle/add" class="btn-cta"><i class="fas fa-plus"></i> Add cattle</a>
    </div>

    <% if (locals.success) { %>
      <div class="alert-modern alert-success" role="status"><i class="fas fa-circle-check mt-1"></i><span><%= success %></span></div>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert-modern alert-error" role="alert"><i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span></div>
    <% } %>

    <form class="filters" action="/farmer/cattle" method="GET">
      <div class="filter-grid">
        <div class="field">
          <label for="q">Search</label>
          <input type="text" id="q" name="q" value="<%= f.q || '' %>" placeholder="Breed, name or state" maxlength="100">
        </div>

        <div class="field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">All</option>
            <% categoryOptions.forEach((option) => { %>
              <option value="<%= option %>" <%= f.category === option ? 'selected' : '' %>><%= option %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="breedType">Breed type</label>
          <select id="breedType" name="breedType">
            <option value="">All</option>
            <% breedTypes.forEach((option) => { %>
              <option value="<%= option %>" <%= f.breedType === option ? 'selected' : '' %>><%= option %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="sold">Status</label>
          <select id="sold" name="sold">
            <option value="">All</option>
            <option value="false" <%= f.sold === 'false' ? 'selected' : '' %>>Available</option>
            <option value="true" <%= f.sold === 'true' ? 'selected' : '' %>>Sold</option>
          </select>
        </div>

        <div class="field">
          <label for="originState">Origin state</label>
          <input type="text" id="originState" name="originState" value="<%= f.originState || '' %>" maxlength="100">
        </div>

        <div class="field">
          <label for="minPrice">Minimum price (₹)</label>
          <input type="number" id="minPrice" name="minPrice" value="<%= f.minPrice ?? '' %>" min="0" step="any" inputmode="decimal">
        </div>

        <div class="field">
          <label for="maxPrice">Maximum price (₹)</label>
          <input type="number" id="maxPrice" name="maxPrice" value="<%= f.maxPrice ?? '' %>" min="0" step="any" inputmode="decimal">
        </div>

        <div class="field">
          <label for="sort">Sort by</label>
          <select id="sort" name="sort">
            <% sorts.forEach(([value, label]) => { %>
              <option value="<%= value %>" <%= (f.sort || 'newest') === value ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="filter-actions">
        <% if (hasFilters || (f.sort && f.sort !== 'newest')) { %>
          <a href="/farmer/cattle" class="btn-soft">Clear filters</a>
        <% } %>
        <button type="submit" class="btn-soft"><i class="fas fa-magnifying-glass"></i> Apply filters</button>
      </div>
    </form>

    <% if (!cattles.length) { %>
      <div class="empty-state">
        <div class="icon"><i class="fas fa-paw"></i></div>
        <% if (hasFilters) { %>
          <h3>No cattle match these filters</h3>
          <p>Try a different search or clear the filters to see everything you have listed.</p>
          <a href="/farmer/cattle" class="btn-soft">Clear filters</a>
        <% } else { %>
          <h3>You have not listed any cattle yet</h3>
          <p>Add your first animal with photos and a price so buyers can find it.</p>
          <a href="/farmer/cattle/add" class="btn-cta"><i class="fas fa-plus"></i> Add cattle</a>
        <% } %>
      </div>
    <% } else { %>

      <div class="cattle-grid">
        <% cattles.forEach((c) => { %>
          <%
            const cover = (Array.isArray(c.images) && c.images[0]) || c.imageUrl || '';
            const displayName = c.name || c.breedName;
            const kind = [c.category, c.breedType].filter(Boolean).join(' / ');
          %>

          <article class="cattle-card">
            <a href="/farmer/cattle/<%= c._id %>" class="cover" aria-label="View <%= displayName %>">
              <% if (cover) { %>
                <img src="<%= cover %>" alt="<%= displayName %>" loading="lazy">
              <% } else { %>
                <i class="fas fa-paw"></i>
              <% } %>

              <span class="tags">
                <span class="tag <%= c.sold ? 'sold' : 'available' %>"><%= c.sold ? 'Sold' : 'Available' %></span>
                <% if (c.isActive === false) { %><span class="tag unlisted">Unlisted</span><% } %>
              </span>
            </a>

            <div class="card-body">
              <span class="kind"><%= kind %></span>
              <a href="/farmer/cattle/<%= c._id %>" class="title"><%= displayName %></a>
              <% if (c.name && c.breedName) { %><span class="sub"><%= c.breedName %></span><% } %>

              <div class="facts">
                <% if (c.gender) { %><span class="fact"><%= c.gender %></span><% } %>
                <% if (hasValue(c.age)) { %><span class="fact"><%= formatAge(c.age) %></span><% } %>
                <% if (hasValue(c.weight)) { %><span class="fact"><%= c.weight %> kg</span><% } %>
                <% if (hasValue(c.avgMilkPerDay)) { %><span class="fact"><%= c.avgMilkPerDay %> L/day</span><% } %>
                <% if (c.originState) { %><span class="fact"><%= c.originState %></span><% } %>
              </div>

              <% if (hasValue(c.price)) { %>
                <div class="price">₹ <%= inr(c.price) %></div>
              <% } else { %>
                <div class="price empty">Price not set</div>
              <% } %>

              <div class="card-actions">
                <a href="/farmer/cattle/<%= c._id %>" class="btn-soft"><i class="fas fa-eye"></i> View</a>
                <a href="/farmer/cattle/<%= c._id %>/edit" class="btn-soft"><i class="fas fa-pen"></i> Edit</a>
                <form action="/farmer/cattle/<%= c._id %>/delete" method="POST" onsubmit="return confirm('Delete this cattle listing? This cannot be undone.')">
                  <input type="hidden" name="redirect" value="/farmer/cattle">
                  <button type="submit" class="btn-soft danger" aria-label="Delete <%= displayName %>"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (pageInfo.totalPages > 1) { %>
        <nav class="pager" aria-label="Cattle pages">
          <a href="<%= pageLink(pageInfo.page - 1) %>" class="btn-soft <%= pageInfo.hasPrev ? '' : 'disabled' %>"><i class="fas fa-arrow-left"></i> Previous</a>
          <span>Page <%= pageInfo.page %> of <%= pageInfo.totalPages %></span>
          <a href="<%= pageLink(pageInfo.page + 1) %>" class="btn-soft <%= pageInfo.hasNext ? '' : 'disabled' %>">Next <i class="fas fa-arrow-right"></i></a>
        </nav>
      <% } %>

    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const navbar = document.querySelector('.navbar');

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 20);
    });
  }
</script>
</body>
</html>
