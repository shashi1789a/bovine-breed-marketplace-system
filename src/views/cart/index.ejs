<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-100">

<div class="max-w-7xl mx-auto py-10 px-5">

<h1 class="text-4xl font-bold mb-8">

My Shopping Cart

</h1>

<% if(!cart || cart.items.length===0){ %>

<div class="bg-white rounded-xl shadow p-12 text-center">

<h2 class="text-2xl font-semibold mb-3">

Your cart is empty

</h2>

<a
href="/api/v1/products"
class="bg-green-600 text-white px-6 py-3 rounded-lg"
>

Continue Shopping

</a>

</div>

<% }else{ %>

<div class="grid lg:grid-cols-3 gap-8">

<!-- ================= CART ITEMS ================= -->

<div class="lg:col-span-2 space-y-6">

<% cart.items.forEach(item=>{ %>

<div class="bg-white rounded-xl shadow p-5 flex gap-5">

<img

src="<%= item.product.image || 'https://placehold.co/150x150' %>"

class="w-36 h-36 rounded-lg object-cover"

>

<div class="flex-1">

<h2 class="text-2xl font-semibold">

<%= item.product.name %>

</h2>

<p class="text-gray-600 mt-2">

<%= item.product.description %>

</p>

<p class="mt-2">

Seller :

<b>

<%= item.seller.fullname %>

</b>

(<%= item.sellerRole %>)

</p>

<p class="mt-2">

Price :

<span class="font-bold text-green-600">

₹ <%= item.price %>

</span>

</p>

<p class="mt-1">

Total :

<span class="font-bold">

₹ <%= item.totalPrice %>

</span>

</p>

<div class="flex items-center gap-5 mt-5">

<form

action="/api/v1/cart/update/<%= item.product._id %>"

method="POST"

class="flex items-center gap-2"

>

<input

type="number"

name="quantity"

value="<%= item.quantity %>"

min="1"

class="border rounded p-2 w-20"

>

<button

class="bg-blue-600 text-white px-4 py-2 rounded"

>

Update

</button>

</form>

<form

action="/api/v1/cart/remove/<%= item.product._id %>"

method="POST"

>

<button

class="bg-red-600 text-white px-4 py-2 rounded"

>

Remove

</button>

</form>

</div>

</div>

</div>

<% }) %>

</div>

<!-- ================= SUMMARY ================= -->

<div>

<div class="bg-white rounded-xl shadow p-6 sticky top-10">

<h2 class="text-2xl font-bold mb-6">

Order Summary

</h2>

<div class="space-y-3">

<div class="flex justify-between">

<span>Total Items</span>

<b>

<%= cart.totalItems %>

</b>

</div>

<div class="flex justify-between">

<span>Total Quantity</span>

<b>

<%= cart.totalQuantity %>

</b>

</div>

<div class="flex justify-between">

<span>Total Amount</span>

<b class="text-2xl text-green-600">

₹ <%= cart.totalAmount %>

</b>

</div>

</div>

<hr class="my-6">

<form

action="/api/v1/cart/clear"

method="POST"

>

<button

class="w-full bg-red-600 text-white py-3 rounded-lg mb-4"

>

Clear Cart

</button>

</form>

<a

href="/api/v1/orders/checkout"

class="block w-full text-center bg-green-600 text-white py-3 rounded-lg"

>

Proceed To Checkout

</a>

<a

href="/api/v1/products"

class="block mt-4 text-center text-blue-600"

>

Continue Shopping

</a>

</div>

</div>

</div>

<% } %>

</div>

</body>

</html>