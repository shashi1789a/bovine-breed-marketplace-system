<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Cart | BoviNetra</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0F62AC;
      --text-main: #1A2C3E;
      --text-muted: #5A6E7F;
      --border-light: rgba(15, 98, 172, 0.12);
      --gradient-cta: linear-gradient(105deg, #F39C12, #E67E22);
      --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.02);
      --shadow-cta: 0 12px 28px -8px rgba(243, 156, 18, 0.4);
      --transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: #F4F9FE;
      color: var(--text-main);
      line-height: 1.5;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5 { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .cart-page { padding: 110px 0 70px; min-height: 100vh; }

    .page-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 1.5rem;
    }

    .page-head h2 { font-size: 1.7rem; margin: 0; }
    .page-head p { color: var(--text-muted); font-size: 0.88rem; margin: 2px 0 0; }

    .panel {
      background: #fff;
      border-radius: 24px;
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 92px 1fr auto;
      gap: 1.1rem;
      padding: 1.2rem 1.4rem;
      border-bottom: 1px solid #EEF4FA;
      align-items: center;
    }

    .cart-item:last-child { border-bottom: none; }

    .item-image {
      width: 92px;
      height: 92px;
      border-radius: 18px;
      background: #EAF3FB;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94A3B8;
      font-size: 1.8rem;
    }

    .item-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .item-name {
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-main);
      text-decoration: none;
      display: block;
      margin-bottom: 2px;
      word-break: break-word;
    }

    a.item-name:hover { color: var(--primary); }

    .item-price { color: var(--text-muted); font-size: 0.86rem; }

    .item-controls {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 0.7rem;
      flex-wrap: wrap;
    }

    .qty-input {
      width: 84px;
      border: 1.5px solid #E2EDF7;
      border-radius: 12px;
      padding: 6px 10px;
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
    }

    .qty-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(15, 98, 172, 0.12); }

    .btn-link-danger {
      background: none;
      border: none;
      color: #B91C1C;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0;
      cursor: pointer;
    }

    .btn-link-danger:hover { text-decoration: underline; }

    .item-total { text-align: right; font-weight: 800; font-size: 1.05rem; white-space: nowrap; }

    .item-issues { margin: 0.7rem 0 0; padding: 0; list-style: none; }

    .item-issues li {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      font-size: 0.8rem;
      color: #B45309;
      background: #FEF3C7;
      border-radius: 10px;
      padding: 6px 10px;
      margin-top: 6px;
    }

    .summary { padding: 1.5rem; position: sticky; top: 100px; }
    .summary h4 { font-size: 1.1rem; margin-bottom: 1rem; }

    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      padding: 0.45rem 0;
      color: var(--text-muted);
    }

    .summary-row strong { color: var(--text-main); }

    .summary-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #EEF4FA;
      margin-top: 0.6rem;
      padding-top: 1rem;
      font-weight: 800;
      font-size: 1.15rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .btn-checkout {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      margin-top: 1.2rem;
      padding: 14px;
      border: none;
      border-radius: 44px;
      background: var(--gradient-cta);
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: var(--shadow-cta);
      transition: var(--transition);
    }

    .btn-checkout:hover { transform: translateY(-2px); color: #fff; }

    .btn-outline-soft {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: 40px;
      border: 1.5px solid #E2EDF7;
      background: #fff;
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: none;
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-outline-soft:hover { border-color: var(--primary); color: var(--primary); }

    .alert-modern {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      border-radius: 16px;
      padding: 12px 16px;
      font-size: 0.88rem;
      font-weight: 500;
      margin-bottom: 1.2rem;
    }

    .alert-error { background: #FEE2E2; color: #B91C1C; }
    .alert-success { background: #DCFCE7; color: #166534; }
    .alert-warning { background: #FEF3C7; color: #92400E; }

    .empty-cart { text-align: center; padding: 4rem 1.5rem; }

    .empty-cart i {
      width: 84px;
      height: 84px;
      border-radius: 50%;
      background: #EAF3FB;
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      margin-bottom: 1.2rem;
    }

    .empty-cart h3 { font-size: 1.4rem; margin-bottom: 6px; }
    .empty-cart p { color: var(--text-muted); margin-bottom: 1.4rem; }

    @media (max-width: 767px) {
      .cart-page { padding: 95px 0 50px; }
      .cart-item { grid-template-columns: 72px 1fr; padding: 1rem; }
      .item-image { width: 72px; height: 72px; font-size: 1.4rem; }
      .item-total { grid-column: 2; text-align: left; }
      .summary { position: static; }
    }
  </style>
</head>
<body>
<%- include('../partials/header') %>

<%
  const inr = (value) =>
    Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  const MAX_QTY = 100;
%>

<main class="cart-page">
  <div class="container">

    <div class="page-head">
      <div>
        <h2>My Cart</h2>
        <p><%= totalItems %> product<%= totalItems === 1 ? '' : 's' %> &middot; <%= totalQuantity %> unit<%= totalQuantity === 1 ? '' : 's' %></p>
      </div>

      <% if (items.length) { %>
        <form action="/cart/clear" method="POST" onsubmit="return confirm('Remove all items from your cart?')">
          <button type="submit" class="btn-outline-soft"><i class="fas fa-trash-can"></i> Clear Cart</button>
        </form>
      <% } %>
    </div>

    <% if (locals.success) { %>
      <div class="alert-modern alert-success" role="status">
        <i class="fas fa-circle-check mt-1"></i><span><%= success %></span>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert-modern alert-error" role="alert">
        <i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span>
      </div>
    <% } %>

    <% if (!items.length) { %>
      <div class="panel empty-cart">
        <i class="fas fa-cart-shopping"></i>
        <h3>Your cart is empty</h3>
        <p>Browse the marketplace and add products you like.</p>
        <a href="/products" class="btn-checkout" style="display: inline-flex; width: auto; padding: 12px 28px; margin: 0;">
          <i class="fas fa-store"></i> Go to Marketplace
        </a>
      </div>
    <% } else { %>

      <% if (hasIssues) { %>
        <div class="alert-modern alert-warning" role="alert">
          <i class="fas fa-triangle-exclamation mt-1"></i>
          <span>Some items need your attention. Availability and prices are checked again at checkout.</span>
        </div>
      <% } %>

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="panel">
            <% items.forEach(item => { %>
              <% const product = item.product; %>

              <div class="cart-item">
                <div class="item-image">
                  <% if (product && product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                  <% } else { %>
                    <i class="fas fa-box-open"></i>
                  <% } %>
                </div>

                <div>
                  <% if (product) { %>
                    <a href="/products/view/<%= product._id %>" class="item-name"><%= product.name %></a>
                  <% } else { %>
                    <span class="item-name">Unavailable product</span>
                  <% } %>

                  <div class="item-price">₹ <%= inr(item.price) %> each</div>

                  <% if (product) { %>
                    <div class="item-controls">
                      <form action="/cart/<%= product._id %>/update" method="POST">
                        <input
                          type="number"
                          name="quantity"
                          class="qty-input"
                          value="<%= item.quantity %>"
                          min="1"
                          max="<%= Math.max(1, Math.min(product.stock > 0 ? product.stock : MAX_QTY, MAX_QTY)) %>"
                          inputmode="numeric"
                          aria-label="Quantity for <%= product.name %>"
                        >
                      </form>

                      <form action="/cart/<%= product._id %>/remove" method="POST">
                        <button type="submit" class="btn-link-danger"><i class="fas fa-xmark me-1"></i>Remove</button>
                      </form>
                    </div>
                  <% } %>

                  <% if (item.issues.length) { %>
                    <ul class="item-issues">
                      <% item.issues.forEach(issue => { %>
                        <li><i class="fas fa-circle-info mt-1"></i><span><%= issue %></span></li>
                      <% }) %>
                    </ul>
                  <% } %>
                </div>

                <div class="item-total">₹ <%= inr(item.totalPrice) %></div>
              </div>
            <% }) %>
          </div>

          <a href="/products" class="btn-outline-soft mt-3"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
        </div>

        <div class="col-lg-4">
          <div class="panel summary">
            <h4>Order Summary</h4>

            <div class="summary-row"><span>Products</span><strong><%= totalItems %></strong></div>
            <div class="summary-row"><span>Total units</span><strong><%= totalQuantity %></strong></div>
            <div class="summary-row"><span>Subtotal</span><strong>₹ <%= inr(totalAmount) %></strong></div>
            <div class="summary-row"><span>Shipping</span><span>Calculated at checkout</span></div>

            <div class="summary-total">
              <span>Total</span>
              <span>₹ <%= inr(totalAmount) %></span>
            </div>

            <a href="/orders/checkout" class="btn-checkout"><i class="fas fa-lock"></i> Proceed to Checkout</a>

            <p class="text-muted mt-3 mb-0" style="font-size: 0.76rem;">
              Items from different sellers are placed as separate orders.
            </p>
          </div>
        </div>
      </div>

    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const navbar = document.querySelector('.navbar');

  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 20);
    });
  }

  document.querySelectorAll('.qty-input').forEach((input) => {
    input.addEventListener('change', () => {
      if (input.checkValidity()) input.form.requestSubmit();
    });
  });
</script>
</body>
</html>