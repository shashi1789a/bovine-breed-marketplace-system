<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || "BoviNetra" %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/tools.css" rel="stylesheet">
</head>
<body>
<%- include("../partials/header") %>

<main class="page">
  <div class="wrap" style="max-width:820px">
    <div class="page-head">
      <div>
        <h2><%= t("Appointments") %></h2>
        <p class="muted"><%= isDoctor ? 'Consultation requests from farmers' : 'Your doctor consultations' %></p>
      </div>
      <div class="actions-x">
        <% if (isDoctor) { %><a class="btn-soft" href="/doctor/availability"><i class="fas fa-clock"></i> <%= t("My availability") %></a>
        <% } else { %><a class="btn-main" href="/doctors"><i class="fas fa-user-doctor"></i> <%= t("Book a doctor") %></a><% } %>
      </div>
    </div>

    <% if (locals.success) { %><div class="alert-modern alert-success" role="status"><%= success %></div><% } %>
    <% if (locals.error) { %><div class="alert-modern alert-error" role="alert"><%= error %></div><% } %>

    <nav class="tabs" aria-label="Appointment lists">
      <a href="/appointments" class="<%= tab === 'upcoming' ? 'active' : '' %>"><%= t("Upcoming") %></a>
      <a href="/appointments?tab=past" class="<%= tab === 'past' ? 'active' : '' %>"><%= t("Past") %></a>
    </nav>

    <% if (!items.length) { %>
      <section class="card-x"><p class="empty-x"><%= t("No appointments here yet.") %></p></section>
    <% } else { items.forEach(item => { %>
      <article class="card-x">
        <div class="row-x" style="border:0;padding:0">
          <div class="grow">
            <strong><%= formatSlot(item.startsAt) %> · <%= item.durationMin %> min</strong>
            <span class="muted"><%= isDoctor ? 'Farmer' : 'Doctor' %>: <%= item.other ? item.other.fullName : 'Deleted user' %><%= item.cattleLabel ? ' · ' + item.cattleLabel : '' %><%= item.fee ? ' · Fee ₹' + item.fee : '' %></span>
          </div>
          <span class="pill <%= item.status %>"><%= item.status %></span>
        </div>
        <p style="margin:8px 0"><%= item.reason %></p>
        <% if (item.doctorNote) { %><p class="muted" style="margin-bottom:8px"><strong><%= t("Doctor's note:") %></strong> <%= item.doctorNote %></p><% } %>
        <div class="actions-x">
          <% if (item.canJoin && item.other) { %><a class="btn-main" href="/chat?with=<%= item.other._id %>&call=1"><i class="fas fa-video"></i> <%= t("Join video call") %></a><% } %>
          <% if (item.other) { %><a class="btn-soft" href="/chat?with=<%= item.other._id %>"><i class="fas fa-comment-dots"></i> <%= t("Message") %></a><% } %>
          <% if (isDoctor && item.status === 'pending') { %>
            <form method="post" action="/appointments/<%= item._id %>/confirm"><button class="btn-main" type="submit"><i class="fas fa-check"></i> <%= t("Confirm") %></button></form>
            <form method="post" action="/appointments/<%= item._id %>/decline"><button class="btn-danger-soft" type="submit"><i class="fas fa-xmark"></i> <%= t("Decline") %></button></form>
          <% } %>
          <% if (item.canComplete) { %>
            <form method="post" action="/appointments/<%= item._id %>/complete" class="actions-x">
              <input class="field" style="min-width:220px" name="note" maxlength="600" placeholder="Advice or prescription note" aria-label="Doctor's note">
              <button class="btn-main" type="submit"><i class="fas fa-clipboard-check"></i> <%= t("Complete") %></button>
            </form>
          <% } %>
          <% if (item.canCancel) { %>
            <form method="post" action="/appointments/<%= item._id %>/cancel" onsubmit="return confirm('Cancel this appointment?')"><button class="btn-danger-soft" type="submit"><%= t("Cancel") %></button></form>
          <% } %>
        </div>
      </article>
    <% }) } %>
  </div>
</main>

<%- include("../partials/footer") %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
