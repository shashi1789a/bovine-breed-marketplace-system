<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || "BoviNetra" %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/tools.css" rel="stylesheet">
</head>
<body>
<%- include("../partials/header") %>

<main class="page">
  <div class="wrap" style="max-width:760px">
    <p class="muted" style="margin-bottom:8px"><a href="/doctors"><i class="fas fa-arrow-left"></i> <%= t("All doctors") %></a></p>

    <% if (locals.success) { %><div class="alert-modern alert-success" role="status"><%= success %></div><% } %>
    <% if (locals.error) { %><div class="alert-modern alert-error" role="alert"><%= error %></div><% } %>

    <section class="card-x">
      <div class="row-x" style="border:0;padding:0">
        <img src="<%= doctor.avatar && /^https:\/\//.test(doctor.avatar) ? doctor.avatar : '/images/default-avatar.png' %>" alt="" width="64" height="64" style="border-radius:50%;object-fit:cover">
        <div class="grow">
          <h2 style="font-size:1.4rem"><%= doctor.fullName %></h2>
          <span class="muted"><%= (doctor.doctorDetails && doctor.doctorDetails.specialization) || 'Veterinary doctor' %><%= doctor.doctorDetails && doctor.doctorDetails.experience != null ? ' · ' + doctor.doctorDetails.experience + ' years experience' : '' %></span>
        </div>
        <strong><%= settings.fee ? '₹' + settings.fee : 'Fee on request' %></strong>
      </div>
      <p class="muted" style="margin-top:8px"><%= settings.slotMinutes %> minute video consultation. Pay the doctor directly.</p>
    </section>

    <% if (isSelf || isDoctorViewer) { %>
      <section class="card-x"><p class="empty-x"><%= t("Doctors cannot book consultations.") %> <a href="/doctor/availability" style="color:var(--primary)"><%= t("Set your availability") %></a></p></section>
    <% } else if (!slots.length) { %>
      <section class="card-x"><p class="empty-x">No free slots in the next <%= days %> days. Please check again later.</p></section>
    <% } else if (!locals.user) { %>
      <section class="card-x"><p class="empty-x"><a class="btn-main" href="/login?next=<%= encodeURIComponent('/doctors/' + doctor._id) %>"><%= t("Log in to book a slot") %></a></p></section>
    <% } else { %>
      <form method="post" action="/appointments" class="card-x">
        <input type="hidden" name="doctorId" value="<%= doctor._id %>">
        <h3><%= t("Choose a time") %></h3>
        <% slots.forEach(group => { %>
          <div class="day-title"><%= new Date(group.day + 'T00:00:00Z').toLocaleString('en-IN', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'UTC' }) %></div>
          <div class="slots">
            <% group.times.forEach(time => { %>
              <label><input type="radio" name="slot" value="<%= time.iso %>" required><span><%= time.label %></span></label>
            <% }) %>
          </div>
        <% }) %>
        <div style="margin-top:16px">
          <label for="reason" class="muted"><%= t("What is the problem?") %></label>
          <textarea class="field" id="reason" name="reason" rows="3" maxlength="400" minlength="5" required placeholder="e.g. Cow not eating since yesterday, mild fever"></textarea>
        </div>
        <div style="margin:10px 0 14px">
          <label for="cattleLabel" class="muted"><%= t("Animal (tag / name, optional)") %></label>
          <input class="field" id="cattleLabel" name="cattleLabel" maxlength="80">
        </div>
        <button class="btn-main" type="submit"><i class="fas fa-calendar-plus"></i> <%= t("Request booking") %></button>
      </form>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
