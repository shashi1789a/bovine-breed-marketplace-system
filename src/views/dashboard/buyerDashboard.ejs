<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0284C7;
      --primary-dark: #0C4A6E;
      --cta: #F59E0B;
      --light: #E0F2FE;
      --text-main: #111827;
      --text-muted: #6B7280;
      --border-light: rgba(2, 132, 199, 0.12);
      --gradient-hero: linear-gradient(135deg, #082F49 0%, #0C4A6E 45%, #0284C7 100%);
      --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
      --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
      --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
      --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
      --radius-card: 24px;
      --radius-pill: 50px;
      --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      --font-heading: 'Poppins', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #F4F9FE;
      font-family: var(--font-body);
      display: flex;
      min-height: 100vh;
      color: var(--text-main);
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); font-weight: 700; }

    .sidebar {
      width: 260px;
      min-height: 100vh;
      background: var(--gradient-hero);
      color: #fff;
      position: fixed;
      inset: 0 auto 0 0;
      overflow-y: auto;
      box-shadow: 4px 0 24px rgba(2, 132, 199, 0.15);
      padding-bottom: 2rem;
      z-index: 1050;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar .profile-wrapper {
      padding: 2rem 1rem 1.2rem;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      margin-bottom: 0.5rem;
    }

    .sidebar .profile-img {
      width: 84px;
      height: 84px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255, 255, 255, 0.55);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      background: #fff;
      padding: 2px;
    }

    .sidebar .user-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; margin-top: 0.7rem; }

    .sidebar .user-role {
      font-size: 0.72rem;
      background: rgba(245, 158, 11, 0.22);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #FCD34D;
      padding: 0.25rem 0.9rem;
      border-radius: 30px;
      display: inline-block;
      margin-top: 0.35rem;
      text-transform: capitalize;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .sidebar .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0.72rem 1.6rem;
      color: rgba(255, 255, 255, 0.82);
      text-decoration: none;
      transition: var(--transition);
      border-left: 4px solid transparent;
      font-weight: 500;
      font-size: 0.92rem;
    }

    .sidebar .nav-link i { width: 22px; font-size: 1.05rem; text-align: center; }

    .sidebar .nav-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border-left-color: var(--cta);
    }

    .sidebar .nav-link.active {
      background: rgba(14, 165, 233, 0.22);
      border-left-color: var(--cta);
      color: #fff;
      font-weight: 600;
    }

    .sidebar .nav-link .count {
      margin-left: auto;
      background: var(--cta);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      border-radius: 20px;
      padding: 1px 8px;
    }

    .sidebar hr { margin: 0.8rem 1.2rem; border-color: rgba(255, 255, 255, 0.12); opacity: 1; }

    .sidebar-toggle {
      display: none;
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 1060;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--gradient-primary);
      color: #fff;
      border: none;
      font-size: 1.2rem;
      box-shadow: var(--shadow-md);
      cursor: pointer;
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(8, 47, 73, 0.55);
      z-index: 1045;
    }

    .sidebar-overlay.active { display: block; }

    .content { margin-left: 260px; padding: 2rem 2.2rem 3rem; flex: 1; min-height: 100vh; min-width: 0; }

    .top-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.8rem;
      background: #fff;
      padding: 1.2rem 1.8rem;
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-light);
      gap: 1rem;
    }

    .top-bar h2 { font-weight: 800; font-size: 1.7rem; margin: 0; letter-spacing: -0.02em; }
    .top-bar .subhead { color: var(--text-muted); font-size: 0.88rem; font-weight: 500; }
    .top-bar .btn-group-custom { display: flex; gap: 10px; flex-wrap: wrap; }

    .top-bar .btn {
      border-radius: var(--radius-pill);
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      font-size: 0.88rem;
      border: none;
      color: #fff;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: var(--transition);
    }

    .top-bar .btn:hover { transform: translateY(-2px); color: #fff; }
    .top-bar .btn-blue { background: var(--gradient-primary); box-shadow: 0 4px 14px rgba(2, 132, 199, 0.28); }
    .top-bar .btn-amber { background: var(--gradient-cta); box-shadow: 0 4px 14px rgba(245, 158, 11, 0.32); }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 1.2rem;
      margin-bottom: 1.8rem;
    }

    .stat-card {
      background: #fff;
      border-radius: var(--radius-card);
      padding: 1.4rem 1.6rem 1.5rem;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      border: 1px solid var(--border-light);
      position: relative;
      overflow: hidden;
    }

    .stat-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }

    .stat-card h6 {
      font-family: var(--font-body);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 0.4rem;
    }

    .stat-card h2 { font-weight: 800; font-size: 2rem; color: var(--primary-dark); margin: 0; line-height: 1; }

    .stat-card .stat-icon { position: absolute; top: 1.2rem; right: 1.4rem; font-size: 2rem; opacity: 0.14; color: var(--primary); }

    .cart-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      background: #fff;
      border: 1px solid var(--border-light);
      border-left: 5px solid var(--cta);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-sm);
      padding: 1.2rem 1.6rem;
      margin-bottom: 1rem;
    }

    .cart-banner strong { font-family: var(--font-heading); }
    .cart-banner span { color: var(--text-muted); font-size: 0.9rem; }

    .section-title {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.3rem;
      margin: 2.2rem 0 1.2rem;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-title i {
      color: var(--primary);
      font-size: 1.2rem;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--light);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(2, 132, 199, 0.15);
    }

    .section-title a { margin-left: auto; font-size: 0.85rem; font-weight: 600; color: var(--primary); text-decoration: none; font-family: var(--font-body); }

    .table-card {
      background: #fff;
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-light);
      overflow: hidden;
    }

    .table-card .table { margin-bottom: 0; }

    .table-card .table thead th {
      background: #F0F9FF;
      color: var(--primary-dark);
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid rgba(2, 132, 199, 0.12);
      padding: 1rem 1.1rem;
      white-space: nowrap;
    }

    .table-card .table td {
      padding: 0.9rem 1.1rem;
      vertical-align: middle;
      border-bottom: 1px solid #F0F9FF;
      font-size: 0.9rem;
    }

    .table-card .table tr:last-child td { border-bottom: none; }

    .badge-status { font-weight: 600; padding: 0.38rem 0.95rem; border-radius: 40px; font-size: 0.72rem; }

    .btn-sm-action {
      border-radius: 30px;
      padding: 0.3rem 0.9rem;
      font-size: 0.75rem;
      font-weight: 600;
      border: none;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 1.2rem;
    }

    .product-card {
      background: #fff;
      border-radius: 20px;
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }

    .product-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }

    .product-image {
      height: 160px;
      background: #EAF3FB;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94A3B8;
      font-size: 2.2rem;
      text-decoration: none;
    }

    .product-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .product-body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; flex: 1; }

    .product-category { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--primary); }

    .product-name {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-main);
      text-decoration: none;
      margin: 3px 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-rating { font-size: 0.78rem; color: #B45309; font-weight: 600; }
    .product-rating span { color: var(--text-muted); font-weight: 500; }

    .product-price { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; margin: 0.4rem 0 0.8rem; }
    .product-price s { font-family: var(--font-body); font-weight: 500; font-size: 0.8rem; color: var(--text-muted); margin-left: 6px; }

    .btn-add {
      margin-top: auto;
      width: 100%;
      border: none;
      border-radius: 40px;
      background: var(--gradient-cta);
      color: #fff;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 9px;
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-add:hover { transform: translateY(-2px); }

    .empty-state { text-align: center; padding: 2.5rem 1rem; color: var(--text-muted); }

    @media (max-width: 991px) {
      .sidebar { transform: translateX(-100%); width: 270px; }
      .sidebar.open { transform: translateX(0); }
      .sidebar-toggle { display: flex; align-items: center; justify-content: center; }
      .content { margin-left: 0; padding: 5rem 1.5rem 2.5rem; }
      .top-bar h2 { font-size: 1.4rem; }
    }

    @media (max-width: 575px) {
      .content { padding: 4.5rem 1rem 2rem; }
      .top-bar { flex-direction: column; align-items: flex-start; padding: 1rem 1.1rem; }
      .top-bar .btn-group-custom { width: 100%; }
      .top-bar .btn { flex: 1; justify-content: center; }
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
      .stat-card { padding: 1.1rem; border-radius: 18px; }
      .stat-card h2 { font-size: 1.4rem; }
      .section-title { font-size: 1.1rem; }
    }

    @media (max-width: 400px) {
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<%
  const inr = (value) =>
    Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

  const homeLink = user.role === 'buyer' ? '/buyer/dashboard' : '/dashboard';

  const orderClass = {
    Placed: 'bg-info text-dark',
    Shipped: 'bg-primary',
    Delivered: 'bg-success',
    Cancelled: 'bg-secondary'
  };

  const paymentClass = {
    Paid: 'bg-success',
    Pending: 'bg-warning text-dark',
    Initiated: 'bg-warning text-dark',
    Failed: 'bg-danger',
    Refunded: 'bg-info text-dark'
  };

  const methodLabel = { COD: 'Cash on Delivery', RAZORPAY: 'Online' };
%>

  <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
    <i class="fas fa-bars"></i>
  </button>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="sidebar" id="sidebar">
    <div class="profile-wrapper">
      <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="profile-img" alt="Avatar">
      <div class="user-name"><%= user.fullName %></div>
      <span class="user-role"><%= user.role %></span>
    </div>

    <hr>

    <a href="<%= homeLink %>" class="nav-link active"><i class="fas fa-home"></i> Dashboard</a>
    <a href="/chat" class="nav-link"><i class="fas fa-comments"></i> Messages</a>
    <a href="/profile" class="nav-link"><i class="fas fa-user"></i> My Profile</a>
    <a href="/products" class="nav-link"><i class="fas fa-store"></i> Marketplace</a>
    <a href="/cart" class="nav-link">
      <i class="fas fa-cart-shopping"></i> My Cart
      <% if (stats.cart.totalItems > 0) { %><span class="count"><%= stats.cart.totalItems %></span><% } %>
    </a>
    <a href="/orders" class="nav-link"><i class="fas fa-bag-shopping"></i> My Orders</a>
    <a href="/breed/detect" class="nav-link"><i class="fas fa-brain"></i> Breed Detector</a>
    <a href="/update-account" class="nav-link"><i class="fas fa-cog"></i> Account Settings</a>
    <hr>
    <a href="/logout" class="nav-link" style="color: rgba(255,200,200,0.85);"><i class="fas fa-sign-out-alt"></i> Logout</a>
  </div>

  <div class="content">

    <div class="top-bar">
      <div>
        <h2>Welcome, <%= user.fullName %></h2>
        <span class="subhead"><i class="far fa-calendar-alt me-1"></i> <%= title %></span>
      </div>
      <div class="btn-group-custom">
        <a href="/products" class="btn btn-blue"><i class="fas fa-store"></i> Marketplace</a>
        <a href="/breed/detect" class="btn btn-amber"><i class="fas fa-brain"></i> Detect Breed</a>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (warnings.length) { %>
      <div class="alert alert-warning" role="alert">
        Some sections could not be loaded: <%= warnings.join(', ') %>.
      </div>
    <% } %>

    <div class="stats-grid">
      <div class="stat-card">
        <h6>Total Orders</h6>
        <h2><%= stats.orders.totalOrders %></h2>
        <span class="stat-icon"><i class="fas fa-bag-shopping"></i></span>
      </div>
      <div class="stat-card">
        <h6>Active Orders</h6>
        <h2><%= stats.orders.activeOrders %></h2>
        <span class="stat-icon"><i class="fas fa-truck-fast"></i></span>
      </div>
      <div class="stat-card">
        <h6>Delivered</h6>
        <h2><%= stats.orders.deliveredOrders %></h2>
        <span class="stat-icon"><i class="fas fa-circle-check"></i></span>
      </div>
      <div class="stat-card">
        <h6>Cancelled</h6>
        <h2><%= stats.orders.cancelledOrders %></h2>
        <span class="stat-icon"><i class="fas fa-ban"></i></span>
      </div>
      <div class="stat-card">
        <h6>Total Spent</h6>
        <h2>₹ <%= inr(stats.orders.totalSpent) %></h2>
        <span class="stat-icon"><i class="fas fa-indian-rupee-sign"></i></span>
      </div>
    </div>

    <div class="cart-banner">
      <% if (stats.cart.totalItems > 0) { %>
        <div>
          <strong>Your cart is waiting</strong><br>
          <span>
            <%= stats.cart.totalItems %> product<%= stats.cart.totalItems === 1 ? '' : 's' %>
            (<%= stats.cart.totalQuantity %> unit<%= stats.cart.totalQuantity === 1 ? '' : 's' %>)
            &middot; ₹ <%= inr(stats.cart.totalAmount) %>
          </span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/cart" class="btn btn-outline-primary btn-sm-action"><i class="fas fa-cart-shopping me-1"></i> View Cart</a>
          <a href="/orders/checkout" class="btn btn-warning btn-sm-action text-white"><i class="fas fa-lock me-1"></i> Checkout</a>
        </div>
      <% } else { %>
        <div>
          <strong>Your cart is empty</strong><br>
          <span>Browse the marketplace to find feed, medicines, vaccines and more.</span>
        </div>
        <a href="/products" class="btn btn-primary btn-sm-action"><i class="fas fa-store me-1"></i> Shop Now</a>
      <% } %>
    </div>

    <div class="section-title">
      <i class="fas fa-receipt"></i> Recent Orders
      <% if (recentOrders.length) { %><a href="/orders">View all <i class="fas fa-arrow-right"></i></a><% } %>
    </div>
    <div class="table-card">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Order</th>
              <th>Items</th>
              <th>Seller</th>
              <th>Date</th>
              <th>Total</th>
              <th>Payment</th>
              <th>Status</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrders.length) { %>
              <% recentOrders.forEach(order => { %>
                <%
                  const first = order.items[0];
                  const more = order.items.length - 1;
                %>
                <tr>
                  <td><strong><%= order.orderNumber %></strong></td>
                  <td>
                    <%= first ? first.name : '-' %>
                    <% if (more > 0) { %><span class="text-muted small">+<%= more %> more</span><% } %>
                  </td>
                  <td><%= order.sellerName %></td>
                  <td><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
                  <td>₹ <%= inr(order.totalAmount) %></td>
                  <td>
                    <span class="badge <%= paymentClass[order.paymentStatus] || 'bg-secondary' %> badge-status"><%= order.paymentStatus %></span>
                    <div class="text-muted" style="font-size: 0.72rem;"><%= methodLabel[order.paymentMethod] || order.paymentMethod %></div>
                  </td>
                  <td><span class="badge <%= orderClass[order.orderStatus] || 'bg-secondary' %> badge-status"><%= order.orderStatus %></span></td>
                  <td class="text-center">
                    <a href="/orders/<%= order._id %>" class="btn btn-sm btn-primary btn-sm-action"><i class="fas fa-eye me-1"></i> View</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" class="empty-state">You have not placed any orders yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="section-title">
      <i class="fas fa-star"></i> Recommended For You
      <a href="/products">Browse all <i class="fas fa-arrow-right"></i></a>
    </div>

    <% if (recommendedProducts.length) { %>
      <div class="product-grid">
        <% recommendedProducts.forEach(product => { %>
          <div class="product-card">
            <a href="/products/view/<%= product._id %>" class="product-image">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
              <% } else { %>
                <i class="fas fa-box-open"></i>
              <% } %>
            </a>

            <div class="product-body">
              <span class="product-category"><%= product.category %></span>
              <a href="/products/view/<%= product._id %>" class="product-name"><%= product.name %></a>

              <% if (product.numOfReviews > 0) { %>
                <div class="product-rating">
                  <i class="fas fa-star"></i> <%= product.ratings %> <span>(<%= product.numOfReviews %>)</span>
                </div>
              <% } %>

              <div class="product-price">
                ₹ <%= inr(product.price) %>
                <% if (product.mrp > product.price) { %><s>₹ <%= inr(product.mrp) %></s><% } %>
              </div>

              <form action="/cart/<%= product._id %>/add" method="POST">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn-add"><i class="fas fa-cart-plus me-1"></i> Add to Cart</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="table-card"><div class="empty-state">No products available right now. Please check back soon.</div></div>
    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function () {
      const sidebar = document.getElementById('sidebar');
      const toggle = document.getElementById('sidebarToggle');
      const overlay = document.getElementById('sidebarOverlay');

      const openSidebar = () => {
        sidebar.classList.add('open');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      };

      const closeSidebar = () => {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      };

      toggle.addEventListener('click', () => {
        sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
      });

      overlay.addEventListener('click', closeSidebar);

      sidebar.querySelectorAll('.nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth <= 991) closeSidebar();
        });
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 991) closeSidebar();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeSidebar();
      });
    })();
  </script>
</body>
</html>