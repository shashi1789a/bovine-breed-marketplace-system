<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
  <%- include("../partials/header", {
    title: "Create Account | BoviNetra",
    description: "Register as a farmer, buyer, doctor or user. Detect cattle breeds with AI and trade on the BoviNetra marketplace."
}) %>

<%
    const previous = locals.formData || {};
    const keep = (name) => (previous[name] === undefined || previous[name] === null ? '' : previous[name]);
    const selectedRole = keep('role');
    const roles = [
        ['farmer', 'Farmer: milk producer or cattle owner'],
        ['buyer', 'Buyer: purchaser or trader'],
        ['doctor', 'Doctor: veterinary expert'],
        ['user', 'User: general bovin user']
    ];
%>

<style>
    .register-page {
        --reg-radius-card: 32px;
        --reg-shadow-md: 0 20px 38px -12px rgba(0,0,0,0.12), 0 4px 12px rgba(0,0,0,0.06);
        --reg-shadow-lg: 0 32px 64px -16px rgba(0,0,0,0.2);
        --reg-shadow-cta: 0 12px 28px -8px rgba(245,158,11,0.4);
        --reg-gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
        --reg-gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
        --reg-border: rgba(2,132,199,0.12);
        --reg-ease: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

        position: relative;
        min-height: 100vh;
        padding: 120px 1.5rem 3rem;
        background: linear-gradient(135deg, #F4F9FE 0%, #EAF3FA 100%);
        overflow-x: clip;
    }

    .register-wrapper { max-width: 1200px; margin: 0 auto; position: relative; z-index: 1; }

    .register-hero {
        background: var(--hero-gradient);
        border-radius: var(--reg-radius-card);
        padding: 3rem;
        color: #fff;
        height: 100%;
        box-shadow: var(--reg-shadow-lg);
        position: relative;
        overflow: hidden;
    }

    .register-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 32px 32px;
        pointer-events: none;
    }

    .register-hero::after {
        content: '';
        position: absolute;
        top: -30%;
        right: -20%;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(245,158,11,0.22), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .register-hero > * { position: relative; z-index: 1; }

    .register-hero .hero-icon {
        width: 76px;
        height: 76px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: var(--cta);
    }

    .register-hero h2 { font-family: var(--font-heading); font-weight: 800; letter-spacing: -0.02em; color: #fff; }

    .register-hero .stat-badge {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 60px;
        padding: 0.5rem 1.2rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .register-card {
        background: rgba(255,255,255,0.98);
        border-radius: var(--reg-radius-card);
        box-shadow: var(--reg-shadow-md);
        border: 1px solid var(--reg-border);
        padding: 2.2rem 2.2rem 2.5rem;
    }

    .register-card .badge-modern {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(2,132,199,0.08);
        border: 1px solid rgba(2,132,199,0.18);
        border-radius: 60px;
        padding: 6px 16px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .register-card h3 { font-family: var(--font-heading); font-weight: 800; color: var(--text-dark); font-size: 1.75rem; }

    .reg-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border-radius: 16px;
        padding: 12px 16px;
        font-size: 0.88rem;
        font-weight: 500;
        margin-bottom: 1.2rem;
        background: #FEE2E2;
        color: #B91C1C;
    }

    .register-card .input-modern {
        background: #FFFFFF;
        border: 1.5px solid #E2EDF7;
        border-radius: 16px;
        padding: 13px 16px 13px 46px;
        width: 100%;
        font-size: 0.92rem;
        font-family: var(--font-body);
        transition: var(--reg-ease);
        color: var(--text-dark);
    }

    .register-card .input-modern::placeholder { color: #9ca3af; }

    .register-card .input-modern:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 4px rgba(14,165,233,0.14);
        background: #F8FDFF;
    }

    .register-card .input-icon-wrap { position: relative; margin-bottom: 1.2rem; }

    .register-card .input-icon-wrap > i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary);
        font-size: 1rem;
        pointer-events: none;
        z-index: 2;
    }

    .register-card .row > [class*="col-"] > .input-icon-wrap { margin-bottom: 0; }

    .register-card .field-hint { font-size: 0.74rem; color: var(--text-muted); margin: -0.8rem 0 1.2rem 4px; }

    .register-card select.input-modern {
        padding: 13px 44px 13px 46px;
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%230284C7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>');
        background-repeat: no-repeat;
        background-position: right 16px center;
    }

    .register-card label.upload-label { font-size: 0.8rem; font-weight: 600; color: var(--text-dark); margin-bottom: 8px; display: block; }

    .register-card .file-input-wrapper input[type="file"] {
        background: #F9FCFE;
        border: 1.5px dashed #C2D9F0;
        border-radius: 16px;
        padding: 12px 14px;
        width: 100%;
        font-size: 0.82rem;
        cursor: pointer;
        transition: var(--reg-ease);
        color: var(--text-muted);
        font-family: var(--font-body);
    }

    .register-card .file-input-wrapper input[type="file"]:hover { border-color: var(--accent); background: #F0F9FF; border-style: solid; }

    .register-card .file-input-wrapper input[type="file"]::file-selector-button {
        background: var(--reg-gradient-primary);
        color: #fff;
        border: none;
        padding: 7px 14px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.78rem;
        cursor: pointer;
        margin-right: 10px;
        font-family: var(--font-body);
    }

    .register-card .dynamic-fields { display: none; margin-top: 1.2rem; padding: 1.2rem 0 0.2rem; border-top: 2px dashed rgba(2,132,199,0.15); }
    .register-card .dynamic-fields.is-visible { display: block; }

    .register-card .dynamic-fields h6 {
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .register-card .dynamic-fields h6::after { content: ''; flex: 1; height: 1px; background: rgba(2,132,199,0.12); }

    .register-card .extra-fields { display: none; }
    .register-card .extra-fields.show-fields { display: block; }

    .register-card .btn-register {
        background: var(--reg-gradient-cta);
        border: none;
        border-radius: 44px;
        padding: 15px 24px;
        font-weight: 700;
        font-size: 0.97rem;
        color: #fff;
        width: 100%;
        transition: var(--reg-ease);
        box-shadow: var(--reg-shadow-cta);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 1.2rem;
        font-family: var(--font-heading);
        cursor: pointer;
    }

    .register-card .btn-register:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 18px 38px -12px rgba(245,158,11,0.55); }
    .register-card .btn-register:disabled { opacity: 0.7; cursor: not-allowed; }

    .register-card .login-link { text-align: center; margin-top: 1.6rem; font-size: 0.86rem; color: var(--text-muted); }
    .register-card .login-link a { color: var(--primary); font-weight: 700; text-decoration: none; }
    .register-card .login-link a:hover { color: var(--cta); text-decoration: underline; }

    .reg-trust-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
        border: 1px solid rgba(2,132,199,0.1);
        border-radius: 60px;
        padding: 12px 22px;
        margin-top: 1.6rem;
        font-size: 0.72rem;
        font-weight: 600;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--text-muted);
    }

    .reg-trust-strip span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .reg-trust-strip i { color: var(--primary); }

    @media (max-width: 992px) {
        .register-page { padding: 100px 1rem 2rem; }
        .register-hero { padding: 2.2rem; text-align: center; height: auto; }
        .register-hero .hero-icon { margin-left: auto; margin-right: auto; }
        .register-hero .d-flex { justify-content: center; }
        .register-card { padding: 1.8rem 1.6rem 2rem; }
    }

    @media (max-width: 768px) {
        .register-hero { padding: 1.8rem 1.5rem; border-radius: 24px; }
        .register-hero h2 { font-size: 1.7rem; }
        .register-card { padding: 1.6rem 1.4rem 1.8rem; border-radius: 24px; }
        .register-card h3 { font-size: 1.4rem; }
    }

    @media (max-width: 576px) {
        .register-page { padding: 92px 0.75rem 1.5rem; }
        .register-hero { padding: 1.5rem 1.2rem; border-radius: 20px; }
        .register-hero h2 { font-size: 1.5rem; line-height: 1.25; }
        .register-card { padding: 1.4rem 1.1rem 1.6rem; border-radius: 20px; }
        .register-card .input-modern { padding: 12px 14px 12px 42px; font-size: 0.88rem; border-radius: 14px; }
        .register-card select.input-modern { padding: 12px 40px 12px 42px; }
        .register-card .input-icon-wrap > i { font-size: 0.9rem; left: 14px; }
        .reg-trust-strip { justify-content: center; flex-direction: column; border-radius: 20px; padding: 14px 16px; gap: 8px; text-align: center; }
    }

    @media (prefers-reduced-motion: reduce) {
        .register-page *, .register-page *::before, .register-page *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
</style>

<main class="register-page">
    <div class="register-wrapper">
        <div class="row g-4 align-items-stretch">

            <div class="col-lg-5">
                <div class="register-hero">
                    <div class="hero-icon"><i class="fas fa-seedling"></i></div>
                    <h2 class="display-5 fw-bold mb-3">Start your <br><span style="color: #F59E0B;">Bovin Journey</span></h2>
                    <p class="opacity-75 mb-4" style="font-size: 0.95rem;">One account to detect cattle breeds with AI, list cattle and products, and buy from trusted sellers on the BoviNetra marketplace.</p>
                    <div class="d-flex gap-3 flex-wrap mb-4">
                        <div class="stat-badge"><i class="fas fa-brain"></i> AI breed detection</div>
                        <div class="stat-badge"><i class="fas fa-store"></i> Bovin marketplace</div>
                    </div>
                    <p class="small opacity-50 mb-0"><i class="fas fa-shield-alt me-1"></i> Choose the role that fits you. Admin accounts are created by the BoviNetra team.</p>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="register-card">
                    <div class="badge-modern"><i class="fas fa-user-plus"></i> Create new account</div>
                    <h3 class="fw-bold mb-1">Join BoviNetra</h3>
                    <p class="text-muted mb-4" style="font-size: 0.85rem;">Enter your details to get started</p>

                    <% if (locals.error) { %>
                        <div class="reg-alert" role="alert" id="regError">
                            <i class="fas fa-circle-exclamation mt-1"></i><span><%= error %></span>
                        </div>
                    <% } %>

                    <form action="/register" method="POST" enctype="multipart/form-data" id="registerForm">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-user"></i>
                                    <input type="text" name="fullName" class="input-modern" placeholder="Full name" autocomplete="name" value="<%= keep('fullName') %>" minlength="2" maxlength="100" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-at"></i>
                                    <input type="text" name="username" class="input-modern" placeholder="Username" autocomplete="username" value="<%= keep('username') %>" pattern="[A-Za-z0-9_.]{3,30}" title="3 to 30 characters: letters, numbers, dot or underscore" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-envelope"></i>
                                    <input type="email" name="email" class="input-modern" placeholder="Email address" autocomplete="email" value="<%= keep('email') %>" maxlength="254" required>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-lock"></i>
                                    <input type="password" name="password" class="input-modern" placeholder="Create a strong password" autocomplete="new-password" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}" title="8 to 72 characters with at least one letter and one number" required>
                                </div>
                                <div class="field-hint" style="margin: 6px 0 0 4px;">At least 8 characters, with a letter and a number.</div>
                            </div>
                        </div>

                        <div class="input-icon-wrap">
                            <i class="fas fa-briefcase"></i>
                            <select name="role" id="roleSelect" class="input-modern" required>
                                <option value="">Select your role</option>
                                <% roles.forEach(([value, label]) => { %>
                                    <option value="<%= value %>" <%= selectedRole === value ? 'selected' : '' %>><%= label %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="upload-label" for="avatarInput"><i class="fas fa-camera me-1" style="color:#0284C7;"></i> Profile avatar</label>
                                <div class="file-input-wrapper">
                                    <input type="file" id="avatarInput" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="upload-label" for="coverInput"><i class="fas fa-image me-1" style="color:#0284C7;"></i> Cover image (optional)</label>
                                <div class="file-input-wrapper">
                                    <input type="file" id="coverInput" name="coverImage" accept="image/jpeg,image/png,image/webp,image/gif">
                                </div>
                            </div>
                        </div>
                        <div class="field-hint" style="margin: 8px 0 0 4px;">JPG, PNG, WEBP or GIF, up to 5 MB each.</div>

                        <div class="dynamic-fields" id="dynamicFields">
                            <h6><i class="fas fa-bolt"></i> Role-specific information</h6>

                            <div id="farmerFields" class="extra-fields">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-tractor"></i>
                                    <input type="text" name="farmName" class="input-modern" placeholder="Farm or business name" maxlength="150">
                                </div>
                                <div class="input-icon-wrap">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <input type="text" name="location" class="input-modern" placeholder="Farm location (city or district)" maxlength="200">
                                </div>
                            </div>

                            <div id="doctorFields" class="extra-fields">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-stethoscope"></i>
                                    <input type="text" name="specialization" class="input-modern" placeholder="Specialization (e.g. Cattle health)" maxlength="150">
                                </div>
                                <div class="input-icon-wrap">
                                    <i class="fas fa-calendar-alt"></i>
                                    <input type="number" name="experience" class="input-modern" placeholder="Years of experience" min="0" max="80">
                                </div>
                            </div>

                            <div id="buyerFields" class="extra-fields">
                                <div class="input-icon-wrap">
                                    <i class="fas fa-warehouse"></i>
                                    <input type="text" name="address" class="input-modern" placeholder="Business address" maxlength="300">
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-register" id="registerButton">
                            <i class="fas fa-user-check"></i> <span>Register and get started</span>
                        </button>

                        <div class="login-link">
                            Already have an account? <a href="/login">Sign in</a>
                        </div>

                        <div class="reg-trust-strip">
                            <span><i class="fas fa-lock"></i> Passwords are encrypted</span>
                            <span><i class="fas fa-user-shield"></i> Role-based access</span>
                            <span><i class="fas fa-credit-card"></i> Payments via Razorpay</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    (function () {
        var MAX_FILE_SIZE = 5 * 1024 * 1024;

        var form = document.getElementById('registerForm');
        var roleSelect = document.getElementById('roleSelect');
        var dynamicBox = document.getElementById('dynamicFields');
        var button = document.getElementById('registerButton');
        var label = button.querySelector('span');
        var idleLabel = label.textContent;
        var groups = {
            farmer: document.getElementById('farmerFields'),
            doctor: document.getElementById('doctorFields'),
            buyer: document.getElementById('buyerFields')
        };

        function handleRoleChange() {
            Object.keys(groups).forEach(function (key) {
                groups[key].classList.remove('show-fields');
            });

            var group = groups[roleSelect.value];

            if (group) {
                group.classList.add('show-fields');
                dynamicBox.classList.add('is-visible');
            } else {
                dynamicBox.classList.remove('is-visible');
            }
        }

        roleSelect.addEventListener('change', handleRoleChange);
        handleRoleChange();

        form.querySelectorAll('input[type="file"]').forEach(function (input) {
            input.addEventListener('change', function () {
                var file = this.files[0];
                var tooBig = Boolean(file) && file.size > MAX_FILE_SIZE;

                this.setCustomValidity(tooBig ? 'This image is larger than 5 MB.' : '');

                if (tooBig) this.reportValidity();

                this.style.borderColor = file && !tooBig ? '#0EA5E9' : '';
                this.style.backgroundColor = file && !tooBig ? '#F0F9FF' : '';
                this.style.borderStyle = file && !tooBig ? 'solid' : '';
            });
        });

        form.addEventListener('submit', function () {
            button.disabled = true;
            label.textContent = 'Creating your account...';
        });

        window.addEventListener('pageshow', function () {
            button.disabled = false;
            label.textContent = idleLabel;
        });

        var errorBox = document.getElementById('regError');

        if (errorBox) errorBox.scrollIntoView({ block: 'center' });
    })();
</script>

<%- include("../partials/footer") %>


</body>
</html>