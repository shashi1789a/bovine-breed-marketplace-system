<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Update Account — BoviNetra</title>

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================================
       BOVINETRA UPDATE ACCOUNT PAGE — DESIGN SYSTEM
       Colors: Blue + Amber (matching main site)
       ============================================================ */
    :root {
        --primary: #0284C7;
        --primary-dark: #0C4A6E;
        --primary-light: #0EA5E9;
        --accent: #0EA5E9;
        --cta: #F59E0B;
        --cta-dark: #D97706;
        --light: #E0F2FE;
        --dark-bg: #082F49;
        --text-main: #111827;
        --text-muted: #6B7280;
        --border-light: rgba(2, 132, 199, 0.12);
        --gradient-hero: linear-gradient(135deg, #082F49 0%, #0C4A6E 45%, #0284C7 100%);
        --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
        --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
        --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
        --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.14);
        --radius-card: 24px;
        --radius-md: 16px;
        --radius-sm: 10px;
        --radius-pill: 50px;
        --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        --font-heading: 'Poppins', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        background: #F4F9FE;
        font-family: var(--font-body);
        color: var(--text-main);
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
        font-weight: 700;
    }

    /* ============================================================
       CARD
       ============================================================ */
    .card {
        max-width: 560px;
        margin: 40px auto;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        transition: var(--transition);
        animation: cardFadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
    }

    .card:hover {
        box-shadow: var(--shadow-lg);
        transform: translateY(-3px);
    }

    @keyframes cardFadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ----- Card Header ----- */
    .card-header {
        background: var(--gradient-hero);
        color: #fff;
        text-align: center;
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 800;
        padding: 1.4rem 1rem;
        border: none;
        letter-spacing: -0.01em;
        position: relative;
        overflow: hidden;
    }

    .card-header::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 22px 22px;
        pointer-events: none;
    }

    .card-header::after {
        content: '';
        position: absolute;
        top: -40%;
        right: -15%;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.22), transparent 70%);
        border-radius: 50%;
        animation: headerOrb 6s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes headerOrb {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(-16px, 14px); }
    }

    .card-header i {
        margin-right: 8px;
        color: var(--cta);
    }

    /* ----- Card Body ----- */
    .card-body {
        padding: 2rem 2rem 1.8rem;
    }

    /* ----- Profile Avatar ----- */
    .profile {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--primary);
        box-shadow: 0 8px 24px rgba(2, 132, 199, 0.22);
        transition: var(--transition);
    }

    .profile:hover {
        transform: scale(1.05);
        border-color: var(--cta);
        box-shadow: 0 12px 32px rgba(245, 158, 11, 0.3);
    }

    .card-body h4 {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.2rem;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }

    .card-body .role-text {
        color: var(--primary);
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: capitalize;
        letter-spacing: 0.02em;
    }

    /* ----- Form Fields ----- */
    .form-label {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        background: #FFFFFF;
        border: 1.5px solid #E2EDF7;
        border-radius: var(--radius-md);
        padding: 12px 16px;
        font-size: 0.92rem;
        font-family: var(--font-body);
        transition: var(--transition);
        color: var(--text-main);
    }

    .form-control::placeholder { color: #9ca3af; }

    .form-control:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.14);
        background: #F8FDFF;
    }

    .form-control[readonly] {
        background: #F0F9FF;
        color: var(--text-muted);
        cursor: not-allowed;
        border-color: rgba(2, 132, 199, 0.15);
    }

    /* ----- Buttons ----- */
    .btn {
        border-radius: var(--radius-pill);
        padding: 0.7rem 1.5rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.92rem;
        border: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn-success {
        background: var(--gradient-cta);
        color: #fff;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.32);
    }

    .btn-success:hover {
        box-shadow: 0 10px 24px rgba(245, 158, 11, 0.48);
        color: #fff;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #082F49, #0C4A6E);
        color: #fff;
        box-shadow: 0 4px 14px rgba(8, 47, 73, 0.28);
    }

    .btn-secondary:hover {
        box-shadow: 0 10px 24px rgba(8, 47, 73, 0.42);
        color: #fff;
    }

    /* ============================================================
       ALERT MESSAGES
       ============================================================ */
    .alert {
        border-radius: var(--radius-md);
        border: none;
        font-weight: 500;
        font-size: 0.88rem;
        padding: 0.9rem 1.2rem;
        animation: alertFadeIn 0.4s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.2rem;
    }

    @keyframes alertFadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-danger {
        background: linear-gradient(135deg, #FEE2E2, #FECACA);
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    .alert-success {
        background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
        color: #0C4A6E;
        border-left: 4px solid var(--primary);
    }

    .alert i {
        font-size: 1.05rem;
    }

    /* ============================================================
       RESPONSIVE DESIGN
       ============================================================ */
    @media (max-width: 768px) {
        body { padding: 1.5rem 0.85rem 2.5rem; }
        .card {
            margin: 20px auto;
            border-radius: 20px;
        }
        .card-header {
            font-size: 1.2rem;
            padding: 1.2rem 1rem;
        }
        .card-body { padding: 1.6rem 1.4rem 1.5rem; }
        .profile {
            width: 100px;
            height: 100px;
            border-width: 3px;
        }
        .card-body h4 { font-size: 1.08rem; }
        .form-control {
            padding: 11px 14px;
            font-size: 0.88rem;
            border-radius: 14px;
        }
        .btn {
            font-size: 0.88rem;
            padding: 0.65rem 1.3rem;
        }
    }

    @media (max-width: 576px) {
        body { padding: 1rem 0.6rem 2rem; }
        .card {
            margin: 12px auto;
            border-radius: 18px;
        }
        .card-header {
            font-size: 1.1rem;
            padding: 1.1rem 0.85rem;
        }
        .card-header i { font-size: 1rem; }
        .card-body { padding: 1.3rem 1.1rem 1.2rem; }
        .profile {
            width: 88px;
            height: 88px;
            border-width: 3px;
        }
        .card-body h4 { font-size: 1rem; }
        .card-body .role-text { font-size: 0.8rem; }
        .form-label { font-size: 0.8rem; }
        .form-control {
            padding: 10px 13px;
            font-size: 0.86rem;
            border-radius: 12px;
        }
        .btn {
            font-size: 0.85rem;
            padding: 0.65rem 1.2rem;
            width: 100%;
        }
        .alert { font-size: 0.82rem; padding: 0.8rem 1rem; }
    }

    @media (max-width: 375px) {
        .card-header { font-size: 1rem; }
        .card-body { padding: 1.1rem 0.9rem 1rem; }
        .profile {
            width: 78px;
            height: 78px;
        }
        .form-control {
            font-size: 0.83rem;
            padding: 9px 12px;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

</head>
<body>

<div class="container">

<div class="card">

<div class="card-header">
    <i class="fas fa-user-edit"></i> Update Account
</div>

<div class="card-body">

<div class="text-center mb-4">

<img
src="<%= user.avatar %>"
class="profile"
alt="avatar"
>

<h4 class="mt-3">
<%= user.fullName %>
</h4>

<p class="role-text mb-0">
<i class="fas fa-user-tag me-1"></i><%= user.role %>
</p>

</div>

<% if(typeof error!="undefined"){ %>

<div class="alert alert-danger">
    <i class="fas fa-exclamation-circle"></i>
    <span><%= error %></span>
</div>

<% } %>

<% if(typeof success!="undefined"){ %>

<div class="alert alert-success">
    <i class="fas fa-check-circle"></i>
    <span><%= success %></span>
</div>

<% } %>

<form action="/api/v1/users/update-account" method="POST" id="updateForm">

<div class="mb-3">

<label class="form-label">
<i class="fas fa-user me-1" style="color:#0284C7;"></i>
Full Name
</label>

<input
type="text"
class="form-control"
name="fullName"
value="<%= user.fullName %>"
placeholder="Enter your full name"
required
minlength="3"
>

</div>

<div class="mb-3">

<label class="form-label">
<i class="fas fa-envelope me-1" style="color:#0284C7;"></i>
Email Address
</label>

<input
type="email"
class="form-control"
name="email"
value="<%= user.email %>"
placeholder="you@example.com"
required
>

</div>

<div class="mb-3">

<label class="form-label">
<i class="fas fa-at me-1" style="color:#0284C7;"></i>
Username
</label>

<input
type="text"
class="form-control"
value="<%= user.username %>"
readonly
>

</div>

<div class="mb-3">

<label class="form-label">
<i class="fas fa-user-shield me-1" style="color:#0284C7;"></i>
Role
</label>

<input
type="text"
class="form-control"
value="<%= user.role %>"
readonly
>

</div>

<button
type="submit"
class="btn btn-success w-100"
>
<i class="fas fa-save"></i> Update Account
</button>

</form>

<div class="text-center mt-4">

<a
href="/api/v1/users/profile"
class="btn btn-secondary"
>
<i class="fas fa-arrow-left"></i> Back to Profile
</a>

</div>

</div>

</div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Form validation
    const updateForm = document.getElementById("updateForm");
    if (updateForm) {
        updateForm.addEventListener("submit", function (e) {
            const fullName = document.querySelector("[name='fullName']").value.trim();
            const email = document.querySelector("[name='email']").value.trim();

            if (fullName.length < 3) {
                e.preventDefault();
                alert("Full name must contain at least 3 characters.");
                return;
            }

            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!regex.test(email)) {
                e.preventDefault();
                alert("Please enter a valid email address.");
            }
        });
    }

    // Subtle staggered entrance for form fields
    document.addEventListener('DOMContentLoaded', function () {
        const fields = document.querySelectorAll('.card-body .mb-3');
        fields.forEach((field, i) => {
            field.style.opacity = '0';
            field.style.transform = 'translateY(10px)';
            field.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            setTimeout(() => {
                field.style.opacity = '1';
                field.style.transform = 'translateY(0)';
            }, 200 + i * 70);
        });
    });
</script>

</body>
</html>