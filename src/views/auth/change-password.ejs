<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password — BoviNetra</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           BOVINETRA CHANGE PASSWORD PAGE — DESIGN SYSTEM
           Colors: Blue + Amber (matching main site)
           ============================================================ */
        :root {
            --primary: #0284C7;
            --primary-dark: #0C4A6E;
            --primary-light: #0EA5E9;
            --accent: #0EA5E9;
            --cta: #F59E0B;
            --cta-dark: #D97706;
            --light: #E0F2FE;
            --dark-bg: #082F49;
            --text-main: #111827;
            --text-muted: #6B7280;
            --border-light: rgba(2, 132, 199, 0.12);
            --gradient-hero: linear-gradient(135deg, #082F49 0%, #0C4A6E 45%, #0284C7 100%);
            --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
            --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
            --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.14);
            --radius-card: 24px;
            --radius-md: 16px;
            --radius-sm: 10px;
            --radius-pill: 50px;
            --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
            --font-heading: 'Poppins', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #F4F9FE;
            font-family: var(--font-body);
            color: var(--text-main);
            min-height: 100vh;
            padding: 2rem 1rem 3rem;
            line-height: 1.6;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            font-weight: 700;
        }

        /* ============================================================
           CARD
           ============================================================ */
        .card {
            max-width: 520px;
            margin: 40px auto;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            transition: var(--transition);
            animation: cardFadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            background: #fff;
        }

        .card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-3px);
        }

        @keyframes cardFadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ----- Card Header ----- */
        .card-header {
            background: var(--gradient-hero);
            color: #fff;
            text-align: center;
            font-family: var(--font-heading);
            font-size: 1.4rem;
            font-weight: 800;
            padding: 1.4rem 1rem;
            border: none;
            letter-spacing: -0.01em;
            position: relative;
            overflow: hidden;
        }

        .card-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }

        .card-header::after {
            content: '';
            position: absolute;
            top: -40%;
            right: -15%;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.22), transparent 70%);
            border-radius: 50%;
            animation: headerOrb 6s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes headerOrb {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(-16px, 14px); }
        }

        .card-header i {
            margin-right: 8px;
            color: var(--cta);
        }

        /* ----- Card Body ----- */
        .card-body {
            padding: 2rem 2rem 1.8rem;
        }

        /* ----- Form Fields ----- */
        .form-label {
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-main);
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            background: #FFFFFF;
            border: 1.5px solid #E2EDF7;
            border-radius: var(--radius-md);
            padding: 12px 16px;
            font-size: 0.92rem;
            font-family: var(--font-body);
            transition: var(--transition);
            color: var(--text-main);
        }

        .form-control::placeholder { color: #9ca3af; }

        .form-control:focus {
            border-color: var(--accent);
            outline: none;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.14);
            background: #F8FDFF;
        }

        /* Input group styling */
        .input-group .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .input-group .btn-toggle {
            background: #F0F9FF;
            border: 1.5px solid #E2EDF7;
            border-left: none;
            border-top-right-radius: var(--radius-md);
            border-bottom-right-radius: var(--radius-md);
            color: var(--primary);
            padding: 0 16px;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-group .btn-toggle:hover {
            background: var(--gradient-primary);
            color: #fff;
            border-color: var(--primary);
        }

        .input-group .btn-toggle i {
            font-size: 0.9rem;
        }

        /* Password strength */
        .password-strength {
            height: 4px;
            border-radius: 4px;
            background: #E2EDF7;
            margin-top: 8px;
            overflow: hidden;
        }

        .password-strength-bar {
            height: 100%;
            width: 0;
            border-radius: 4px;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .strength-weak   { background: linear-gradient(90deg, #EF4444, #F87171); }
        .strength-medium { background: linear-gradient(90deg, #F59E0B, #FCD34D); }
        .strength-strong { background: linear-gradient(90deg, #0284C7, #0EA5E9); }

        /* ----- Buttons ----- */
        .btn {
            border-radius: var(--radius-pill);
            padding: 0.7rem 1.5rem;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.92rem;
            border: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-success {
            background: var(--gradient-cta);
            color: #fff;
            box-shadow: 0 4px 14px rgba(245, 158, 11, 0.32);
        }

        .btn-success:hover {
            box-shadow: 0 10px 24px rgba(245, 158, 11, 0.48);
            color: #fff;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #082F49, #0C4A6E);
            color: #fff;
            box-shadow: 0 4px 14px rgba(8, 47, 73, 0.28);
        }

        .btn-secondary:hover {
            box-shadow: 0 10px 24px rgba(8, 47, 73, 0.42);
            color: #fff;
        }

        /* ============================================================
           ALERT MESSAGES
           ============================================================ */
        .alert {
            border-radius: var(--radius-md);
            border: none;
            font-weight: 500;
            font-size: 0.88rem;
            padding: 0.9rem 1.2rem;
            animation: alertFadeIn 0.4s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.2rem;
        }

        @keyframes alertFadeIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .alert-danger {
            background: linear-gradient(135deg, #FEE2E2, #FECACA);
            color: #991B1B;
            border-left: 4px solid #EF4444;
        }

        .alert-success {
            background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
            color: #0C4A6E;
            border-left: 4px solid var(--primary);
        }

        .alert i {
            font-size: 1.05rem;
        }

        /* Message text */
        #message {
            font-size: 0.85rem;
            font-weight: 600;
            color: #EF4444;
            min-height: 20px;
        }

        /* ============================================================
           RESPONSIVE DESIGN
           ============================================================ */
        @media (max-width: 768px) {
            body { padding: 1.5rem 0.85rem 2.5rem; }
            .card {
                margin: 20px auto;
                border-radius: 20px;
            }
            .card-header {
                font-size: 1.2rem;
                padding: 1.2rem 1rem;
            }
            .card-body { padding: 1.6rem 1.4rem 1.5rem; }
            .form-control {
                padding: 11px 14px;
                font-size: 0.88rem;
                border-radius: 14px;
            }
            .btn {
                font-size: 0.88rem;
                padding: 0.65rem 1.3rem;
            }
        }

        @media (max-width: 576px) {
            body { padding: 1rem 0.6rem 2rem; }
            .card {
                margin: 12px auto;
                border-radius: 18px;
            }
            .card-header {
                font-size: 1.1rem;
                padding: 1.1rem 0.85rem;
            }
            .card-header i { font-size: 1rem; }
            .card-body { padding: 1.3rem 1.1rem 1.2rem; }
            .form-label { font-size: 0.8rem; }
            .form-control {
                padding: 10px 13px;
                font-size: 0.86rem;
                border-radius: 12px;
            }
            .input-group .btn-toggle {
                padding: 0 13px;
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }
            .btn {
                font-size: 0.85rem;
                padding: 0.65rem 1.2rem;
                width: 100%;
            }
            .alert { font-size: 0.82rem; padding: 0.8rem 1rem; }
        }

        @media (max-width: 375px) {
            .card-header { font-size: 1rem; }
            .card-body { padding: 1.1rem 0.9rem 1rem; }
            .form-control {
                font-size: 0.82rem;
                padding: 9px 12px;
            }
        }

        /* Reduced motion */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>

</head>
<body>

<div class="container">

    <div class="card">

        <div class="card-header">
            <i class="fas fa-key"></i> Change Password
        </div>

        <div class="card-body">

            <% if(typeof error !== "undefined"){ %>

                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <span><%= error %></span>
                </div>

            <% } %>

            <% if(typeof success !== "undefined"){ %>

                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <span><%= success %></span>
                </div>

            <% } %>

            <form action="/api/v1/users/change-password" method="POST" id="changePasswordForm">

                <div class="mb-3">

                    <label class="form-label" for="oldPassword">
                        <i class="fas fa-lock me-1" style="color:#0284C7;"></i>
                        Old Password
                    </label>

                    <div class="input-group">

                        <input
                            type="password"
                            class="form-control"
                            name="oldPassword"
                            id="oldPassword"
                            placeholder="Enter your current password"
                            required
                        >

                        <button
                            type="button"
                            class="btn-toggle"
                            onclick="togglePassword('oldPassword', this)"
                            aria-label="Toggle password visibility"
                        >
                            <i class="fas fa-eye"></i>
                        </button>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label" for="newPassword">
                        <i class="fas fa-key me-1" style="color:#0284C7;"></i>
                        New Password
                    </label>

                    <div class="input-group">

                        <input
                            type="password"
                            class="form-control"
                            name="newPassword"
                            id="newPassword"
                            placeholder="Min. 8 characters"
                            minlength="8"
                            required
                        >

                        <button
                            type="button"
                            class="btn-toggle"
                            onclick="togglePassword('newPassword', this)"
                            aria-label="Toggle password visibility"
                        >
                            <i class="fas fa-eye"></i>
                        </button>

                    </div>

                    <div class="password-strength">
                        <div class="password-strength-bar" id="strengthBar"></div>
                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label" for="confirmPassword">
                        <i class="fas fa-check-double me-1" style="color:#0284C7;"></i>
                        Confirm Password
                    </label>

                    <div class="input-group">

                        <input
                            type="password"
                            class="form-control"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Re-enter new password"
                            required
                        >

                        <button
                            type="button"
                            class="btn-toggle"
                            onclick="togglePassword('confirmPassword', this)"
                            aria-label="Toggle password visibility"
                        >
                            <i class="fas fa-eye"></i>
                        </button>

                    </div>

                </div>

                <div class="text-danger mb-3" id="message"></div>

                <button class="btn btn-success w-100" type="submit">
                    <i class="fas fa-shield-halved"></i> Change Password
                </button>

            </form>

            <div class="text-center mt-4">
                <a href="/api/v1/users/profile" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Profile
                </a>
            </div>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    /* ---- Password visibility toggle ---- */
    function togglePassword(id, btn) {
        const input = document.getElementById(id);
        if (!input) return;

        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";

        const icon = btn.querySelector('i');
        if (icon) {
            icon.className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
        }
    }

    /* ---- Password strength meter ---- */
    const newPasswordInput = document.getElementById('newPassword');
    const strengthBar = document.getElementById('strengthBar');

    if (newPasswordInput && strengthBar) {
        newPasswordInput.addEventListener('input', function () {
            const val = this.value;
            let strength = 0;

            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            let width = '0%';
            let cls = '';

            if (val.length === 0) {
                width = '0%';
            } else if (strength <= 1) {
                width = '33%';
                cls = 'strength-weak';
            } else if (strength === 2 || strength === 3) {
                width = '66%';
                cls = 'strength-medium';
            } else {
                width = '100%';
                cls = 'strength-strong';
            }

            strengthBar.style.width = width;
            strengthBar.className = 'password-strength-bar ' + cls;
        });
    }

    /* ---- Form validation ---- */
    const form = document.getElementById('changePasswordForm');
    if (form) {
        form.addEventListener('submit', function (e) {
            const newPass = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            const messageEl = document.getElementById('message');

            if (newPass !== confirm) {
                e.preventDefault();
                messageEl.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Passwords do not match.';
                return;
            }

            if (newPass.length < 8) {
                e.preventDefault();
                messageEl.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Password must be at least 8 characters.';
                return;
            }

            messageEl.innerHTML = '';
        });
    }
</script>

</body>
</html>