<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Update Cover Image — BoviNetra</title>

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================================
       BOVINETRA UPDATE COVER IMAGE PAGE — DESIGN SYSTEM
       Colors: Blue + Amber (matching main site)
       ============================================================ */
    :root {
        --primary: #0284C7;
        --primary-dark: #0C4A6E;
        --primary-light: #0EA5E9;
        --accent: #0EA5E9;
        --cta: #F59E0B;
        --cta-dark: #D97706;
        --light: #E0F2FE;
        --dark-bg: #082F49;
        --text-main: #111827;
        --text-muted: #6B7280;
        --border-light: rgba(2, 132, 199, 0.12);
        --gradient-hero: linear-gradient(135deg, #082F49 0%, #0C4A6E 45%, #0284C7 100%);
        --gradient-cta: linear-gradient(105deg, #F59E0B, #D97706);
        --gradient-primary: linear-gradient(135deg, #0284C7, #0EA5E9);
        --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.06);
        --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.14);
        --radius-card: 24px;
        --radius-md: 16px;
        --radius-sm: 10px;
        --radius-pill: 50px;
        --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        --font-heading: 'Poppins', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        background: #F4F9FE;
        font-family: var(--font-body);
        color: var(--text-main);
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
        font-weight: 700;
    }

    /* ============================================================
       CARD
       ============================================================ */
    .card {
        max-width: 720px;
        margin: 40px auto;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        transition: var(--transition);
        animation: cardFadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
    }

    .card:hover {
        box-shadow: var(--shadow-lg);
        transform: translateY(-3px);
    }

    @keyframes cardFadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ----- Card Header ----- */
    .card-header {
        background: var(--gradient-hero);
        color: #fff;
        text-align: center;
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 800;
        padding: 1.4rem 1rem;
        border: none;
        letter-spacing: -0.01em;
        position: relative;
        overflow: hidden;
    }

    .card-header::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 22px 22px;
        pointer-events: none;
    }

    .card-header::after {
        content: '';
        position: absolute;
        top: -40%;
        right: -15%;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.22), transparent 70%);
        border-radius: 50%;
        animation: headerOrb 6s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes headerOrb {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(-16px, 14px); }
    }

    .card-header i {
        margin-right: 8px;
        color: var(--cta);
    }

    /* ----- Card Body ----- */
    .card-body {
        padding: 2rem 2rem 1.8rem;
    }

    /* ----- Cover Image Preview ----- */
    .cover {
        width: 100%;
        height: 280px;
        object-fit: cover;
        border-radius: var(--radius-md);
        border: 3px solid var(--primary);
        box-shadow: 0 12px 32px rgba(2, 132, 199, 0.18);
        transition: var(--transition);
        background: linear-gradient(135deg, #082F49, #0C4A6E);
        display: block;
    }

    .cover:hover {
        border-color: var(--cta);
        box-shadow: 0 16px 40px rgba(245, 158, 11, 0.28);
    }

    /* ----- Form Fields ----- */
    .form-label {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        background: #FFFFFF;
        border: 1.5px solid #E2EDF7;
        border-radius: var(--radius-md);
        padding: 12px 16px;
        font-size: 0.88rem;
        font-family: var(--font-body);
        transition: var(--transition);
        color: var(--text-main);
        cursor: pointer;
    }

    .form-control:hover {
        border-color: var(--accent);
        background: #F8FDFF;
    }

    .form-control:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.14);
        background: #F8FDFF;
    }

    .form-control::file-selector-button {
        background: var(--gradient-primary);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.82rem;
        cursor: pointer;
        margin-right: 12px;
        font-family: var(--font-body);
        transition: var(--transition);
    }

    .form-control::file-selector-button:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

    /* ----- Buttons ----- */
    .btn {
        border-radius: var(--radius-pill);
        padding: 0.7rem 1.5rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.92rem;
        border: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn-success {
        background: var(--gradient-cta);
        color: #fff;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.32);
    }

    .btn-success:hover {
        box-shadow: 0 10px 24px rgba(245, 158, 11, 0.48);
        color: #fff;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #082F49, #0C4A6E);
        color: #fff;
        box-shadow: 0 4px 14px rgba(8, 47, 73, 0.28);
    }

    .btn-secondary:hover {
        box-shadow: 0 10px 24px rgba(8, 47, 73, 0.42);
        color: #fff;
    }

    /* ============================================================
       ALERT MESSAGES
       ============================================================ */
    .alert {
        border-radius: var(--radius-md);
        border: none;
        font-weight: 500;
        font-size: 0.88rem;
        padding: 0.9rem 1.2rem;
        animation: alertFadeIn 0.4s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.2rem;
    }

    @keyframes alertFadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-danger {
        background: linear-gradient(135deg, #FEE2E2, #FECACA);
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    .alert-success {
        background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
        color: #0C4A6E;
        border-left: 4px solid var(--primary);
    }

    .alert i {
        font-size: 1.05rem;
    }

    /* ============================================================
       RESPONSIVE DESIGN
       ============================================================ */
    @media (max-width: 768px) {
        body { padding: 1.5rem 0.85rem 2.5rem; }
        .card {
            margin: 20px auto;
            border-radius: 20px;
        }
        .card-header {
            font-size: 1.2rem;
            padding: 1.2rem 1rem;
        }
        .card-body { padding: 1.6rem 1.4rem 1.5rem; }
        .cover {
            height: 220px;
            border-radius: 14px;
        }
        .form-control {
            padding: 11px 14px;
            font-size: 0.85rem;
            border-radius: 14px;
        }
        .btn {
            font-size: 0.88rem;
            padding: 0.65rem 1.3rem;
        }
    }

    @media (max-width: 576px) {
        body { padding: 1rem 0.6rem 2rem; }
        .card {
            margin: 12px auto;
            border-radius: 18px;
        }
        .card-header {
            font-size: 1.1rem;
            padding: 1.1rem 0.85rem;
        }
        .card-header i { font-size: 1rem; }
        .card-body { padding: 1.3rem 1.1rem 1.2rem; }
        .cover {
            height: 180px;
            border-radius: 12px;
            border-width: 2px;
        }
        .form-label { font-size: 0.8rem; }
        .form-control {
            padding: 10px 13px;
            font-size: 0.83rem;
            border-radius: 12px;
        }
        .form-control::file-selector-button {
            padding: 6px 12px;
            font-size: 0.75rem;
            margin-right: 8px;
        }
        .btn {
            font-size: 0.85rem;
            padding: 0.65rem 1.2rem;
            width: 100%;
        }
        .alert { font-size: 0.82rem; padding: 0.8rem 1rem; }
    }

    @media (max-width: 375px) {
        .card-header { font-size: 1rem; }
        .card-body { padding: 1.1rem 0.9rem 1rem; }
        .cover {
            height: 150px;
            border-radius: 10px;
        }
        .form-control {
            font-size: 0.8rem;
            padding: 9px 12px;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

</head>

<body>

<div class="container">

<div class="card">

<div class="card-header">
    <i class="fas fa-image"></i> Update Cover Image
</div>

<div class="card-body">

<div class="mb-4">

<img
id="preview"
src="<%= user.coverImage %>"
class="cover"
alt="Cover Image"
>

</div>

<% if(error){ %>

<div class="alert alert-danger">
    <i class="fas fa-exclamation-circle"></i>
    <span><%= error %></span>
</div>

<% } %>

<% if(success){ %>

<div class="alert alert-success">
    <i class="fas fa-check-circle"></i>
    <span><%= success %></span>
</div>

<% } %>

<form
action="/api/v1/users/cover-image"
method="POST"
enctype="multipart/form-data"
>

<div class="mb-3">

<label class="form-label" for="coverImage">
<i class="fas fa-upload me-1" style="color:#0284C7;"></i>
Choose New Cover Image
</label>

<input
type="file"
class="form-control"
name="coverImage"
id="coverImage"
accept="image/*"
required
>

</div>

<button
type="submit"
class="btn btn-success w-100"
>
<i class="fas fa-check"></i> Update Cover Image
</button>

</form>

<div class="text-center mt-4">

<a
href="/api/v1/users/profile"
class="btn btn-secondary"
>
<i class="fas fa-arrow-left"></i> Back to Profile
</a>

</div>

</div>

</div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Live image preview
    const input = document.getElementById("coverImage");
    const preview = document.getElementById("preview");

    if (input && preview) {
        input.addEventListener("change", function () {
            const file = this.files[0];
            if (file) {
                // Validate file type
                if (!file.type.startsWith('image/')) {
                    alert('Please select a valid image file (JPG, PNG, etc.)');
                    this.value = '';
                    return;
                }

                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    this.value = '';
                    return;
                }

                preview.src = URL.createObjectURL(file);
                preview.style.borderColor = '#F59E0B';
                preview.style.boxShadow = '0 0 0 6px rgba(245, 158, 11, 0.15), 0 16px 40px rgba(245, 158, 11, 0.28)';
            }
        });
    }
</script>

</body>
</html>