<!DOCTYPE html>
<html>
<head>
    <title>404</title>
</head>
<body>
    <%- include('./partials/header') %>

<main class="container d-flex flex-column align-items-center justify-content-center text-center"
      style="min-height: 70vh; padding-top: 120px;">

  <div class="mb-3" style="font-size: 4rem; font-weight: 800; opacity: 0.15;">404</div>

  <h1 class="h3 mb-2"><%= locals.title || 'Page Not Found' %></h1>
  <p class="text-muted mb-4" style="max-width: 480px;">
    The page you're looking for doesn't exist or may have been moved.
  </p>

  <div class="d-flex gap-2">
    <% if (locals.user) { %>
      <a href="/dashboard" class="btn btn-cta-nav">Go to my dashboard</a>
    <% } else { %>
      <a href="/" class="btn btn-cta-nav">Go to homepage</a>
    <% } %>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a>
  </div>

</main>

<%- include('./partials/footer') %>

</body>
</html>