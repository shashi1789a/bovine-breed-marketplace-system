<script>
(function () {
  var nav = document.getElementById('mainNavbar');
  if (!nav || nav.dataset.ready) return;
  nav.dataset.ready = '1';

  function closeAll(except) {
    nav.querySelectorAll('[data-nav-dropdown]').forEach(function (t) {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      t.classList.remove('show');
      var m = t.parentElement.querySelector('.dropdown-menu');
      if (m) m.classList.remove('show');
    });
  }

  nav.querySelectorAll('[data-nav-dropdown]').forEach(function (toggle) {
    toggle.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var menu = toggle.parentElement.querySelector('.dropdown-menu');
      if (!menu) return;
      closeAll(toggle);
      var open = !menu.classList.contains('show');
      menu.classList.toggle('show', open);
      toggle.classList.toggle('show', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  document.addEventListener('click', function (e) {
    if (!nav.contains(e.target)) closeAll();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAll();
  });

  // Mobile menu fallback (only if Bootstrap JS did not load on this page)
  if (!window.bootstrap) {
    var btn = nav.querySelector('.navbar-toggler');
    var panel = document.getElementById('navbarMain');
    if (btn && panel) {
      btn.addEventListener('click', function () {
        var open = panel.classList.toggle('show');
        btn.classList.toggle('collapsed', !open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  }
})();
</script>

