<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%
  function buildQuery(page) {
    var params = new URLSearchParams();
    if (filters.q) params.set('q', filters.q);
    if (filters.status) params.set('status', filters.status);
    if (filters.category) params.set('category', filters.category);
    params.set('page', page);
    return '/admin/products?' + params.toString();
  }
%>

<%- include('../partials/header') %>

<main class="container" style="padding-top: 120px; padding-bottom: 60px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Manage Products</h1>
    <span class="text-muted"><%= totalProducts %> product<%= totalProducts === 1 ? '' : 's' %></span>
  </div>

  <% if (locals.success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (locals.error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <% if (pendingCount > 0 && filters.status !== 'Pending') { %>
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
      <span><%= pendingCount %> product(s) are waiting for approval.</span>
      <a href="/admin/products?status=Pending" class="btn btn-sm btn-warning">Review now</a>
    </div>
  <% } %>

  <form action="/admin/products" method="GET" class="row g-2 align-items-end mb-4">

    <div class="col-md-4">
      <label class="form-label small mb-1">Search</label>
      <input type="text" class="form-control" name="q" placeholder="Name or brand" value="<%= filters.q || '' %>">
    </div>

    <div class="col-md-3">
      <label class="form-label small mb-1">Status</label>
      <select class="form-select" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(function (s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-3">
      <label class="form-label small mb-1">Category</label>
      <select class="form-select" name="category">
        <option value="">All categories</option>
        <% categories.forEach(function (cat) { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-2 d-grid">
      <button type="submit" class="btn btn-cta-nav"><i class="fas fa-filter"></i> Filter</button>
    </div>

  </form>

  <% if (!products.length) { %>
    <div class="alert alert-light border text-center py-5">No products match these filters.</div>
  <% } else { %>

    <div class="card">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Product</th>
              <th>Seller</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (product) { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <% if (product.image) { %>
                      <img src="<%= product.image %>" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:6px;">
                    <% } %>
                    <div>
                      <a href="/products/view/<%= product._id %>" class="text-decoration-none d-block"><%= product.name %></a>
                      <span class="small text-muted"><%= product.category %></span>
                      <% if (product.featured) { %><span class="badge bg-info ms-1">Featured</span><% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <%= product.owner ? product.owner.fullName : 'Unknown' %>
                  <div class="small text-muted text-capitalize"><%= product.ownerRole %></div>
                </td>
                <td>₹<%= product.price %></td>
                <td><%= product.stock %> <%= product.unit %></td>
                <td>
                  <% if (product.approvalStatus === 'Approved') { %>
                    <span class="badge bg-success">Approved</span>
                  <% } else if (product.approvalStatus === 'Rejected') { %>
                    <span class="badge bg-danger">Rejected</span>
                    <% if (product.rejectionReason) { %>
                      <div class="small text-muted mt-1"><%= product.rejectionReason %></div>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1 align-items-end">

                    <% if (product.approvalStatus !== 'Approved') { %>
                      <form action="/admin/products/<%= product._id %>/approve" method="POST">
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                      </form>
                    <% } %>

                    <% if (product.approvalStatus !== 'Rejected') { %>
                      <details id="reject-<%= product._id %>">
                        <summary class="btn btn-sm btn-outline-danger">Reject</summary>
                        <form action="/admin/products/<%= product._id %>/reject" method="POST" class="mt-2 d-flex gap-1">
                          <input type="text" name="reason" class="form-control form-control-sm"
                                 placeholder="Reason" required minlength="3" maxlength="500" style="width:160px;">
                          <button type="submit" class="btn btn-sm btn-danger">Confirm</button>
                        </form>
                      </details>
                    <% } %>

                    <% if (product.approvalStatus === 'Approved') { %>
                      <form action="/admin/products/<%= product._id %>/feature" method="POST">
                        <input type="hidden" name="featured" value="<%= product.featured ? 'false' : 'true' %>">
                        <button type="submit" class="btn btn-sm btn-outline-info">
                          <%= product.featured ? 'Unfeature' : 'Feature' %>
                        </button>
                      </form>
                    <% } %>

                    <form action="/admin/products/<%= product._id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this product? This cannot be undone.');">
                      <button type="submit" class="btn btn-sm btn-outline-secondary">Delete</button>
                    </form>

                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (pagination.totalPages > 1) { %>
      <nav class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
            <a class="page-link" href="<%= buildQuery(pagination.page - 1) %>">Previous</a>
          </li>
          <li class="page-item disabled">
            <span class="page-link">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
          </li>
          <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
            <a class="page-link" href="<%= buildQuery(pagination.page + 1) %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>

  <% } %>

</main>

<script>
  if (location.hash) {
    var target = document.querySelector(location.hash);
    if (target && target.tagName === 'DETAILS') target.open = true;
  }
</script>

<%- include('../partials/footer') %>

</body>
</html>